@page
@model IndexModel
@{
    ViewData["Title"] = "Categories Management";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-folder-fill"></i> Categories Management</h1>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="bi bi-plus-circle"></i> Create New
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search & Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row g-3">
                    <div class="col-md-6">
                        <input type="text" class="form-control" name="searchKeyword"
                               value="@Model.SearchKeyword" placeholder="Search by name or description...">
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="filterActive">
                            <option value="">All Status</option>
                            <option value="true" selected="@(Model.FilterActive == true)">Active</option>
                            <option value="false" selected="@(Model.FilterActive == false)">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Categories Table -->
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Parent</th>
                            <th>Articles</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@category.CategoryId</span></td>
                                <td><strong>@category.CategoryName</strong></td>
                                <td>@category.CategoryDesciption</td>
                                <td>
                                    @if (category.ParentCategoryId.HasValue)
                                    {
                                        <span class="badge bg-info">@category.ParentCategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Root</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary">@category.ArticleCount</span>
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@category.CategoryId" style="display:inline;">
                                        <button type="submit" class="btn btn-sm @(category.IsActive == true ? "btn-success" : "btn-secondary")">
                                            @(category.IsActive == true ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-warning btn-sm"
                                                onclick="loadEditModal(@category.CategoryId)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm"
                                                onclick="confirmDelete(@category.CategoryId, '@category.CategoryName')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Create New Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-page="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category Name *</label>
                        <input type="text" name="CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description *</label>
                        <textarea name="CategoryDesciption" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Category</label>
                        <select name="ParentCategoryId" class="form-select">
                            <option value="">-- None (Root Category) --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch">
                        <input type="checkbox" name="IsActive" class="form-check-input" checked />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="editModalBody">
                <div class="text-center p-4">
                    <div class="spinner-border" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            if (confirm(`Are you sure you want to delete category "${name}"?`)) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '?handler=Delete&id=' + id;
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = '__RequestVerificationToken';
                input.value = token;
                form.appendChild(input);
                document.body.appendChild(form);
                form.submit();
            }
        }

        async function loadEditModal(id) {
            const response = await fetch(`/api/Categories/${id}`);
            const category = await response.json();

            const modalBody = `
                <form asp-page="Edit" method="post">
                    <input type="hidden" name="CategoryId" value="${category.categoryId}" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Category Name *</label>
                            <input type="text" name="CategoryName" class="form-control" value="${category.categoryName}" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description *</label>
                            <textarea name="CategoryDesciption" class="form-control" rows="3" required>${category.categoryDesciption}</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Parent Category</label>
                            <select name="ParentCategoryId" class="form-select">
                                <option value="">-- None --</option>
                                ${@Html.Raw(Json.Serialize(Model.Categories.Select(c => new { c.CategoryId, c.CategoryName })))}
                            </select>
                        </div>
                        <div class="form-check form-switch">
                            <input type="checkbox" name="IsActive" class="form-check-input" ${category.isActive ? 'checked' : ''} />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Update
                        </button>
                    </div>
                </form>
            `;

            document.getElementById('editModalBody').innerHTML = modalBody;
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }
    </script>
}