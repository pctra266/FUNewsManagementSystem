@page
@model DetailsModel
@{
    ViewData["Title"] = "Tag Details";
}

<div class="container">
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h3><i class="bi bi-tag-fill"></i> @Model.Tag.TagName</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tag ID</dt>
                <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Tag.TagId</span></dd>

                <dt class="col-sm-3">Tag Name</dt>
                <dd class="col-sm-9"><strong>@Model.Tag.TagName</strong></dd>

                <dt class="col-sm-3">Note</dt>
                <dd class="col-sm-9">@Model.Tag.Note</dd>

                <dt class="col-sm-3">Articles Count</dt>
                <dd class="col-sm-9"><span class="badge bg-primary">@Model.Articles.Count</span></dd>
            </dl>

            <hr />

            <h4>Articles with this tag:</h4>
            @if (Model.Articles.Any())
            {
                <div class="list-group">
                    @foreach (var article in Model.Articles)
                    {
                        <a href="/NewsArticles/Details?id=@article.NewsArticleId"
                           class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@article.NewsTitle</h6>
                                <small class="text-muted">@article.CreatedDate?.ToString("dd/MM/yyyy")</small>
                            </div>
                            <p class="mb-1 text-muted small">@article.Headline</p>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No articles found with this tag.
                </div>
            }
        </div>
        <div class="card-footer">
            <a asp-page="Edit" asp-route-id="@Model.Tag.TagId" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>