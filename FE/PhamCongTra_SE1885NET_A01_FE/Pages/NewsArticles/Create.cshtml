@page
@model CreateModel
@{
    ViewData["Title"] = "Create News Article";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-plus-circle"></i> Create News Article</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="NewsArticle.NewsArticleId" class="form-label"></label>
                                <input asp-for="NewsArticle.NewsArticleId" class="form-control"
                                       placeholder="e.g., NEWS001" />
                                <span asp-validation-for="NewsArticle.NewsArticleId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewsArticle.CategoryId" class="form-label"></label>
                                <select asp-for="NewsArticle.CategoryId" class="form-select"
                                        asp-items="ViewBag.CategoryId">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="NewsArticle.CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewsArticle.NewsTitle" class="form-label"></label>
                            <input asp-for="NewsArticle.NewsTitle" class="form-control"
                                   placeholder="Enter article title" />
                            <span asp-validation-for="NewsArticle.NewsTitle" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewsArticle.Headline" class="form-label"></label>
                            <input asp-for="NewsArticle.Headline" class="form-control"
                                   placeholder="Short headline" />
                            <span asp-validation-for="NewsArticle.Headline" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewsArticle.NewsContent" class="form-label"></label>
                            <textarea asp-for="NewsArticle.NewsContent" class="form-control"
                                      rows="8" placeholder="Article content"></textarea>
                            <span asp-validation-for="NewsArticle.NewsContent" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewsArticle.NewsSource" class="form-label"></label>
                            <input asp-for="NewsArticle.NewsSource" class="form-control"
                                   placeholder="Source URL or reference" />
                            <span asp-validation-for="NewsArticle.NewsSource" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tags</label>
                            <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var tag in Model.Tags)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="SelectedTagIds" value="@tag.TagId"
                                               id="tag_@tag.TagId">
                                        <label class="form-check-label" for="tag_@tag.TagId">
                                            @tag.TagName
                                        </label>
                                    </div>
                                }
                            </div>
                            <small class="text-muted">Select tags related to this article</small>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="NewsArticle.NewsStatus" class="form-check-input"
                                       type="checkbox" checked>
                                <label asp-for="NewsArticle.NewsStatus" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Create Article
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}