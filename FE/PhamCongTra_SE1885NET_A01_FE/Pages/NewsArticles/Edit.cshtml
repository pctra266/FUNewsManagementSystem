@page
@model EditModel
@{
    ViewData["Title"] = "Edit News Article";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0"><i class="bi bi-pencil-square"></i> Edit News Article</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="NewsArticle.NewsArticleId" />
                        <input type="hidden" asp-for="NewsArticle.CreatedById" />
                        <input type="hidden" asp-for="NewsArticle.CreatedDate" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Article ID</label>
                                <input value="@Model.NewsArticle.NewsArticleId" class="form-control" disabled />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewsArticle.CategoryId" class="form-label"></label>
                                <select asp-for="NewsArticle.CategoryId" class="form-select"
                                        asp-items="ViewBag.CategoryId">
                                    <option value="">-- Select Category --</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewsArticle.NewsTitle" class="form-label"></label>
                            <input asp-for="NewsArticle.NewsTitle" class="form-control" />
                            <span asp-validation-for="NewsArticle.NewsTitle" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewsArticle.Headline" class="form-label"></label>
                            <input asp-for="NewsArticle.Headline" class="form-control" />
                            <span asp-validation-for="NewsArticle.Headline" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewsArticle.NewsContent" class="form-label"></label>
                            <textarea asp-for="NewsArticle.NewsContent" class="form-control" rows="8"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewsArticle.NewsSource" class="form-label"></label>
                            <input asp-for="NewsArticle.NewsSource" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tags</label>
                            <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var tag in Model.Tags)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="SelectedTagIds" value="@tag.TagId"
                                               id="tag_@tag.TagId"
                                               checked="@Model.SelectedTagIds.Contains(tag.TagId)">
                                        <label class="form-check-label" for="tag_@tag.TagId">
                                            @tag.TagName
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="NewsArticle.NewsStatus" class="form-check-input" type="checkbox">
                                <label asp-for="NewsArticle.NewsStatus" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <small>
                                <strong>Created:</strong> @Model.NewsArticle.CreatedDate?.ToString("dd/MM/yyyy HH:mm")<br />
                                <strong>Last Modified:</strong> @Model.NewsArticle.ModifiedDate?.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Update Article
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}