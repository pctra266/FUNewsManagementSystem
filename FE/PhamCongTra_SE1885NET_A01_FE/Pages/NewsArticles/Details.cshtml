@page
@model DetailsModel
@{
    ViewData["Title"] = "Article Details";
}

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="badge @(Model.NewsArticle.NewsStatus == true ? "bg-success" : "bg-secondary") fs-6">
                            @(Model.NewsArticle.NewsStatus == true ? "Active" : "Inactive")
                        </span>
                        <span class="text-muted ms-2">
                            <i class="bi bi-calendar"></i>
                            @Model.NewsArticle.CreatedDate?.ToString("dd MMMM yyyy")
                        </span>
                    </div>

                    <h1 class="display-5">@Model.NewsArticle.NewsTitle</h1>
                    <h5 class="text-muted mb-4">@Model.NewsArticle.Headline</h5>

                    <div class="mb-3">
                        <span class="badge bg-primary">
                            <i class="bi bi-folder"></i> @Model.NewsArticle.Category?.CategoryName
                        </span>
                    </div>

                    <hr />

                    <div class="article-content mb-4">
                        @Html.Raw(Model.NewsArticle.NewsContent)
                    </div>

                    @if (Model.Tags.Any())
                    {
                        <div class="mb-3">
                            <strong>Tags:</strong>
                            @foreach (var tag in Model.Tags)
                            {
                                <span class="badge bg-info text-dark me-1">@tag.TagName</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.NewsArticle.NewsSource))
                    {
                        <div class="alert alert-light">
                            <strong>Source:</strong>
                            <a href="@Model.NewsArticle.NewsSource" target="_blank">
                                @Model.NewsArticle.NewsSource
                            </a>
                        </div>
                    }

                    <div class="text-muted small">
                        <p class="mb-1">
                            <strong>Created by:</strong> @Model.NewsArticle.CreatedBy?.AccountName
                            on @Model.NewsArticle.CreatedDate?.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        @if (Model.NewsArticle.ModifiedDate.HasValue)
                        {
                            <p class="mb-0">
                                <strong>Last modified:</strong> @Model.NewsArticle.ModifiedDate?.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        }
                    </div>
                </div>
                <div class="card-footer bg-white">
                    <div class="btn-group" role="group">
                        <a asp-page="Edit" asp-route-id="@Model.NewsArticle.NewsArticleId"
                           class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-page="Delete" asp-route-id="@Model.NewsArticle.NewsArticleId"
                           class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                        <a asp-page="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Articles Sidebar -->
        <div class="col-lg-4">
            @if (Model.RelatedArticles.Any())
            {
                <div class="card shadow">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-link-45deg"></i> Related Articles</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var related in Model.RelatedArticles)
                        {
                            <a asp-page="Details" asp-route-id="@related.NewsArticleId"
                               class="list-group-item list-group-item-action">
                                <h6 class="mb-1">@related.NewsTitle</h6>
                                <small class="text-muted">
                                    @related.CreatedDate?.ToString("dd/MM/yyyy")
                                </small>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .article-content {
        line-height: 1.8;
        font-size: 1.1rem;
    }
</style>