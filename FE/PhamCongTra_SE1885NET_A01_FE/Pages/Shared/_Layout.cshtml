<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FU News Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <i class="bi bi-newspaper"></i> FU News Management
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @{
                            var role = Context.Session.GetString("Role");
                        }

                        @if (role == "ADMIN")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Dashboard/Index">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Accounts/Index">
                                    <i class="bi bi-people"></i> Accounts
                                </a>
                            </li>
                        }

                        @if (role == "ADMIN" || role == "STAFF")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/NewsArticles/Index">
                                    <i class="bi bi-newspaper"></i> Articles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Categories/Index">
                                    <i class="bi bi-folder"></i> Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Tags/Index">
                                    <i class="bi bi-tags"></i> Tags
                                </a>
                            </li>
                        }

                        @if (role == "LECTURER")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/NewsArticles/Index">
                                    <i class="bi bi-newspaper"></i> View Articles
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> @Context.Session.GetString("UserName")
                                <span class="badge bg-primary">@role</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#"><i class="bi bi-person"></i> Profile</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-gear"></i> Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Login" asp-page-handler="Logout">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid mt-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center py-3">
            &copy; 2024 - FU News Management System - <a href="#">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>