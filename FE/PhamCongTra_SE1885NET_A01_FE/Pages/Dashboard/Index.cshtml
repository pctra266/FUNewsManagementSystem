@page
@model IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <h1 class="mb-4"><i class="bi bi-speedometer2"></i> Admin Dashboard</h1>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-2">
            <div class="card text-white bg-primary shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Total Articles</h6>
                            <h2 class="mb-0">@Model.TotalArticles</h2>
                        </div>
                        <i class="bi bi-newspaper fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-success shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Active</h6>
                            <h2 class="mb-0">@Model.ActiveArticles</h2>
                        </div>
                        <i class="bi bi-check-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-info shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Categories</h6>
                            <h2 class="mb-0">@Model.TotalCategories</h2>
                        </div>
                        <i class="bi bi-folder fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-warning shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Tags</h6>
                            <h2 class="mb-0">@Model.TotalTags</h2>
                        </div>
                        <i class="bi bi-tags fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-danger shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Users</h6>
                            <h2 class="mb-0">@Model.TotalUsers</h2>
                        </div>
                        <i class="bi bi-people fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-secondary shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Inactive</h6>
                            <h2 class="mb-0">@(Model.TotalArticles - Model.ActiveArticles)</h2>
                        </div>
                        <i class="bi bi-x-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Recent Articles -->
        <div class="col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Articles</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var article in Model.RecentArticles)
                                {
                                    <tr>
                                        <td>
                                            <a href="/NewsArticles/Details?id=@article.NewsArticleId">
                                                @article.NewsTitle
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">
                                                @article.Category?.CategoryName
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(article.NewsStatus == true ? "bg-success" : "bg-secondary")">
                                                @(article.NewsStatus == true ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @article.CreatedDate?.ToString("dd/MM/yyyy")
                                            </small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Categories -->
        <div class="col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill"></i> Top Categories</h5>
                </div>
                <div class="card-body">
                    @foreach (var category in Model.TopCategories)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <strong>@category.CategoryName</strong>
                                <br />
                                <small class="text-muted">@category.CategoryDesciption</small>
                            </div>
                            <span class="badge bg-primary fs-5">@category.ArticleCount</span>
                        </div>
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar" style="width: @(category.ArticleCount * 100.0 / Model.TotalArticles)%"></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Report -->
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-graph-up"></i> Statistics Report</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Start Date</label>
                        <input type="date" asp-for="StartDate" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">End Date</label>
                        <input type="date" asp-for="EndDate" class="form-control" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-search"></i> Generate Report
                        </button>
                    </div>
                </div>
            </form>

            @if (Model.Statistics.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Total Articles</th>
                                <th>Active</th>
                                <th>Inactive</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in Model.Statistics)
                            {
                                <tr>
                                    <td>@stat.DateString</td>
                                    <td>@stat.TotalArticles</td>
                                    <td><span class="badge bg-success">@stat.ActiveArticles</span></td>
                                    <td><span class="badge bg-secondary">@stat.InactiveArticles</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>