@page
@model Presentation_RazorPage.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Reports";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">Reports</h1>
                </div>
                <div class="d-flex gap-2">
                    <form method="post" asp-page-handler="Export" class="d-inline" data-skip-loading="true">
                        <input type="hidden" name="GroupBy" value="@Model.GroupBy" />
                        <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
                        <input type="hidden" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-file-excel me-2"></i>Export Excel
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Messages -->
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Report Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-filter me-2"></i>Report Filters
                    </h6>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Group By</label>
                            <select name="GroupBy" class="form-select" asp-for="GroupBy">
                                <option value="category">Category</option>
                                <option value="author">Author</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Start Date</label>
                            <input type="date" name="StartDate" class="form-control" asp-for="StartDate" max="@today" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">End Date</label>
                            <input type="date" name="EndDate" class="form-control" asp-for="EndDate" max="@today" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sort Order</label>
                            <select name="SortOrder" class="form-select" asp-for="SortOrder">
                                <option value="desc">Newest First</option>
                                <option value="asc">Oldest First</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Apply Filters
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-chart-pie me-2"></i>@(Model.GroupBy == "author" ? "Author" : "Category") Distribution
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="distributionChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-chart-bar me-2"></i>Status Distribution
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="statusChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Content -->
    @if (Model.GroupBy == "author")
    {
        <!-- Author Report -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0 fw-semibold text-primary">Articles by Author</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.AuthorStats.Any())
                        {

                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Author</th>
                                            <th>Total Articles</th>
                                            <th>Active</th>
                                            <th>Inactive</th>
                                            <th>Last Article</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var stat in Model.AuthorStats)
                                        {
                                            <tr>
                                                <td>@stat.AuthorName</td>
                                                <td>@stat.TotalArticles</td>
                                                <td><span class="badge bg-success">@stat.ActiveArticles</span></td>
                                                <td><span class="badge bg-warning">@stat.InactiveArticles</span></td>
                                                <td>@stat.LastArticleDate</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td>Total</td>
                                            <td>@Model.TotalArticles</td>
                                            <td>@Model.TotalActiveArticles</td>
                                            <td>@Model.TotalInactiveArticles</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-user-edit fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">No Data Available</h5>
                                <p class="text-muted">No author statistics found for the selected period.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Category Report -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0 fw-semibold text-primary">Articles by Category</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.CategoryStats.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Category</th>
                                            <th>Total Articles</th>
                                            <th>Active</th>
                                            <th>Inactive</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var stat in Model.CategoryStats)
                                        {
                                            <tr>
                                                <td>@stat.CategoryName</td>
                                                <td>@stat.TotalArticles</td>
                                                <td><span class="badge bg-success">@stat.ActiveArticles</span></td>
                                                <td><span class="badge bg-warning">@stat.InactiveArticles</span></td>
                                            </tr>
                                        }
                                        <tr>
                                            <td>Total</td>
                                            <td>@Model.TotalArticles</td>
                                            <td>@Model.TotalActiveArticles</td>
                                            <td>@Model.TotalInactiveArticles</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">No Data Available</h5>
                                <p class="text-muted">No category statistics found for the selected period.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Article Details -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">Article Details</h6>
                </div>
                <div class="card-body">
                    @if (Model.ArticleDetails.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Author</th>
                                        <th>Category</th>
                                        <th>Created Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var article in Model.ArticleDetails)
                                    {
                                        <tr>
                                            <td>@article.NewsTitle</td>
                                            <td>@article.CreatedByName</td>
                                            <td>@article.CategoryName</td>
                                            <td>@article.CreatedDate?.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (article.NewsStatus == true)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Data Available</h5>
                            <p class="text-muted">No article details found for the selected period.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <script>
        // Prepare data for Distribution Chart (Pie)
        @if (Model.GroupBy == "author")
        {
            <text>
            const distributionLabels = @Html.Raw(Json.Serialize(Model.AuthorStats.Select(a => a.AuthorName).ToList()));
            const distributionData = @Html.Raw(Json.Serialize(Model.AuthorStats.Select(a => a.TotalArticles).ToList()));
            </text>
        }
        else
        {
            <text>
            const distributionLabels = @Html.Raw(Json.Serialize(Model.CategoryStats.Select(c => c.CategoryName).ToList()));
            const distributionData = @Html.Raw(Json.Serialize(Model.CategoryStats.Select(c => c.TotalArticles).ToList()));
            </text>
        }

        // Prepare data for Status Chart (Bar)
        const statusLabels = ['Active', 'Inactive'];
        const statusData = [@Model.TotalActiveArticles, @Model.TotalInactiveArticles];

        // Color palette
        const colorPalette = [
            'rgba(54, 162, 235, 0.8)',
            'rgba(255, 99, 132, 0.8)',
            'rgba(255, 206, 86, 0.8)',
            'rgba(75, 192, 192, 0.8)',
            'rgba(153, 102, 255, 0.8)',
            'rgba(255, 159, 64, 0.8)',
            'rgba(199, 199, 199, 0.8)',
            'rgba(83, 102, 255, 0.8)',
            'rgba(255, 99, 255, 0.8)',
            'rgba(99, 255, 132, 0.8)'
        ];

        // Initialize Distribution Chart (Pie)
        const distributionCtx = document.getElementById('distributionChart');
        if (distributionCtx && distributionData.length > 0) {
            new Chart(distributionCtx, {
                type: 'pie',
                data: {
                    labels: distributionLabels,
                    datasets: [{
                        label: 'Articles',
                        data: distributionData,
                        backgroundColor: colorPalette,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 15,
                                padding: 10,
                                font: {
                                    size: 11
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.parsed || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((value / total) * 100).toFixed(1);
                                    return label + ': ' + value + ' (' + percentage + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Initialize Status Chart (Bar)
        const statusCtx = document.getElementById('statusChart');
        if (statusCtx) {
            new Chart(statusCtx, {
                type: 'bar',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        label: 'Number of Articles',
                        data: statusData,
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.8)',
                            'rgba(255, 159, 64, 0.8)'
                        ],
                        borderColor: [
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 159, 64, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const value = context.parsed.y || 0;
                                    const total = statusData.reduce((a, b) => a + b, 0);
                                    const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                    return 'Articles: ' + value + ' (' + percentage + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>
}