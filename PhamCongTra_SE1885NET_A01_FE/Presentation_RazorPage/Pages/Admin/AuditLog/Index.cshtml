@page
@model Presentation_RazorPage.Pages.Admin.AuditLog.IndexModel
@{
    ViewData["Title"] = "Audit Log";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">Audit Log</h1>
                    <p class="text-muted mb-0">View history of data changes</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-filter me-2"></i>Filters
                    </h6>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">User</label>
                            <select name="FilterUserId" class="form-select" asp-for="FilterUserId">
                                <option value="">All Users</option>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.AccountId">@user.AccountName (@user.AccountEmail)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Entity Type</label>
                            <select name="FilterEntityType" class="form-select" asp-for="FilterEntityType">
                                <option value="">All Entity Types</option>
                                @foreach (var entityType in Model.EntityTypes)
                                {
                                    <option value="@entityType">@entityType</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Apply
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit Log Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-history me-2"></i>Audit History (@Model.AuditLogs.Count entries)
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.AuditLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px;">ID</th>
                                        <th style="width: 150px;">User</th>
                                        <th style="width: 100px;">Action</th>
                                        <th style="width: 120px;">Entity</th>
                                        <th style="width: 80px;">Entity ID</th>
                                        <th style="width: 150px;">Timestamp</th>
                                        <th style="width: 80px;">Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.AuditLogs)
                                    {
                                        <tr>
                                            <td>@log.LogId</td>
                                            <td>
                                                <div class="fw-semibold">@log.UserName</div>
                                                <small class="text-muted">@log.UserEmail</small>
                                            </td>
                                            <td>
                                                @if (log.Action == "CREATE")
                                                {
                                                    <span class="badge bg-success">@log.Action</span>
                                                }
                                                else if (log.Action == "UPDATE")
                                                {
                                                    <span class="badge bg-warning text-dark">@log.Action</span>
                                                }
                                                else if (log.Action == "DELETE")
                                                {
                                                    <span class="badge bg-danger">@log.Action</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@log.Action</span>
                                                }
                                            </td>
                                            <td>@log.EntityName</td>
                                            <td>@log.EntityId</td>
                                            <td>
                                                <div>@log.Timestamp.ToString("MMM dd, yyyy")</div>
                                                <small class="text-muted">@log.Timestamp.ToString("HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-primary" 
                                                        data-bs-toggle="collapse" 
                                                        data-bs-target="#details-@log.LogId">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                        <tr class="collapse" id="details-@log.LogId">
                                            <td colspan="7" class="bg-light">
                                                <div class="row p-3">
                                                    <div class="col-md-6">
                                                        <h6 class="text-danger fw-bold">
                                                            <i class="fas fa-arrow-left me-2"></i>Before (Old Values)
                                                        </h6>
                                                        <pre class="bg-white p-3 border rounded" style="max-height: 300px; overflow-y: auto; font-size: 0.85rem;">@log.FormattedOldValues</pre>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h6 class="text-success fw-bold">
                                                            <i class="fas fa-arrow-right me-2"></i>After (New Values)
                                                        </h6>
                                                        <pre class="bg-white p-3 border rounded" style="max-height: 300px; overflow-y: auto; font-size: 0.85rem;">@log.FormattedNewValues</pre>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Audit Logs Found</h5>
                            <p class="text-muted">No audit entries match the selected filters.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-collapse all details when opening a new one
        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
            button.addEventListener('click', function() {
                const targetId = this.getAttribute('data-bs-target');
                document.querySelectorAll('.collapse.show').forEach(collapse => {
                    if ('#' + collapse.id !== targetId) {
                        bootstrap.Collapse.getInstance(collapse)?.hide();
                    }
                });
            });
        });
    </script>
}
