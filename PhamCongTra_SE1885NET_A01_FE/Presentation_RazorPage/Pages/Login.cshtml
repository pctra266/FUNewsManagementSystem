@page
@model Presentation_RazorPage.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h2 class="h4 mb-1">FU News Management System</h2>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @Model.ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="LoginData.Email" class="form-label">Email Address</label>
                            <input asp-for="LoginData.Email" class="form-control" placeholder="Enter your email" />
                            <span asp-validation-for="LoginData.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LoginData.Password" class="form-label">Password</label>
                            <input asp-for="LoginData.Password" type="password" class="form-control" placeholder="Enter your password" />
                            <span asp-validation-for="LoginData.Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Sign In</button>
                    </form>

                    <div class="text-start mt-4">
                        <h6 class="mb-1">Account Demo</h6>
                        <small class="text-muted">Admin : admin@FUNewsManagementSystem.org / @@@@abc123@@@@ </small> <br />
                        <small class="text-muted">Staff : EmmaWilliam@FUNewsManagement.org/@@1 </small> <br />
                        <small class="text-muted">Lecture :IsabellaDavid@FUNewsManagement.org/@@1 </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}