@page
@using System.Text.RegularExpressions
@model Presentation_RazorPage.Pages.News.ActiveModel
@{
    ViewData["Title"] = "Active News Articles";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">Active News Articles</h1>
                    <p class="text-muted">Browse all published news articles</p>
                    @if (Model.Pagination.TotalItems > 0)
                    {
                        <small class="text-info">
                            Showing @Model.Pagination.StartItem - @Model.Pagination.EndItem of @Model.Pagination.TotalItems articles
                        </small>
                    }
                </div>
                <div>
                    @if (Model.HasFilters)
                    {
                        <a href="/News/Active" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Clear Filters
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Advanced Search & Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-search me-2"></i>Advanced Search & Filters
                    </h6>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SearchTerm" class="form-label">Search Term</label>
                            <input asp-for="SearchTerm" class="form-control"
                                   placeholder="Search in title and content..." />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AuthorName" class="form-label">Author Name</label>
                            <input asp-for="AuthorName" class="form-control"
                                   placeholder="Author's name..." />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label">Category</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">All Categories</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId">@category.CategoryName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label">From Date</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EndDate" class="form-label">To Date</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SortBy" class="form-label">Sort By</label>
                            <select asp-for="SortBy" class="form-select">
                                <option value="date">Date</option>
                                <option value="title">Title</option>
                                <option value="author">Author</option>
                                <option value="category">Category</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="SortOrder" class="form-label">Sort Order</label>
                            <select asp-for="SortOrder" class="form-select">
                                <option value="desc">Newest First</option>
                                <option value="asc">Oldest First</option>
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <input type="hidden" name="currentPage" value="1" />
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-filter me-2"></i>Apply Filters
                            </button>
                        </div>
                    </form>

                    @if (Model.HasFilters)
                    {
                        <div class="mt-3">
                            <a href="/News/Active" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-eraser me-2"></i>Clear All Filters
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Articles Grid -->
    <div class="row">
        @if (Model.ActiveArticles.Any())
        {
            @foreach (var article in Model.ActiveArticles)
            {
                <div class="col-lg-6 col-xl-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary">@article.CategoryName</span>
                                <small class="text-muted">@article.CreatedDate?.ToString("MMM dd, yyyy")</small>
                            </div>

                            <h5 class="card-title">
                                <a href="/News/Details/@article.NewsArticleId" class="link-dark text-decoration-none">
                                    @article.NewsTitle
                                </a>
                            </h5>

                            <p class="card-text text-muted mb-2">@article.Headline</p>

                            @if (!string.IsNullOrEmpty(article.NewsContent) && article.NewsContent.Length > 100)
                            {
                                <p class="card-text">
                                    @(article.NewsContent.Substring(0, 100))...
                                </p>
                            }
                            else if (!string.IsNullOrEmpty(article.NewsContent))
                            {
                                <p class="card-text">@article.NewsContent</p>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-user me-1"></i>@article.CreatedByName
                                </small>
                                <a href="/News/Details/@article.NewsArticleId" class="btn btn-outline-primary btn-sm">
                                    Read More <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Articles Found</h5>
                        <p class="text-muted">
                            @if (Model.HasFilters)
                            {
                                <span>No articles match your search criteria. Try adjusting your filters.</span>
                            }
                            else
                            {
                                <span>There are no active news articles available at the moment.</span>
                            }
                        </p>
                        <div class="mt-3">
                            <a href="/News/Active" class="btn btn-primary">
                                <i class="fas fa-refresh me-2"></i>Clear Filters
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.Pagination.TotalPages > 1)
    {
        <div class="row">
            <div class="col-12">
                <nav aria-label="Articles pagination" class="d-flex justify-content-center">
                    <ul class="pagination">
                        <!-- Previous Button -->
                        <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                            @if (Model.Pagination.HasPreviousPage)
                            {
                                <a class="page-link" href="@Model.GetPageUrl(Model.Pagination.CurrentPage - 1)" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                    <span class="sr-only">Previous</span>
                                </a>
                            }
                            else
                            {
                                <span class="page-link" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                    <span class="sr-only">Previous</span>
                                </span>
                            }
                        </li>

                        <!-- First Page -->
                        @if (Model.Pagination.GetPageNumbers().First() > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Model.GetPageUrl(1)">1</a>
                            </li>
                            @if (Model.Pagination.GetPageNumbers().First() > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        <!-- Page Numbers -->
                        @foreach (var pageNum in Model.Pagination.GetPageNumbers())
                        {
                            <li class="page-item @(pageNum == Model.Pagination.CurrentPage ? "active" : "")">
                                @if (pageNum == Model.Pagination.CurrentPage)
                                {
                                    <span class="page-link">
                                        @pageNum
                                        <span class="sr-only">(current)</span>
                                    </span>
                                }
                                else
                                {
                                    <a class="page-link" href="@Model.GetPageUrl(pageNum)">@pageNum</a>
                                }
                            </li>
                        }

                        <!-- Last Page -->
                        @if (Model.Pagination.GetPageNumbers().Last() < Model.Pagination.TotalPages)
                        {
                            @if (Model.Pagination.GetPageNumbers().Last() < Model.Pagination.TotalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="@Model.GetPageUrl(Model.Pagination.TotalPages)">@Model.Pagination.TotalPages</a>
                            </li>
                        }

                        <!-- Next Button -->
                        <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                            @if (Model.Pagination.HasNextPage)
                            {
                                <a class="page-link" href="@Model.GetPageUrl(Model.Pagination.CurrentPage + 1)" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                    <span class="sr-only">Next</span>
                                </a>
                            }
                            else
                            {
                                <span class="page-link" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                    <span class="sr-only">Next</span>
                                </span>
                            }
                        </li>
                    </ul>
                </nav>

                <!-- Pagination Info -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted">
                        <small>
                            Page @Model.Pagination.CurrentPage of @Model.Pagination.TotalPages
                            (@Model.Pagination.TotalItems total articles)
                        </small>
                    </div>
                    <div class="btn-group" role="group" aria-label="Page size options">
                        <a href="@Model.GetPageSizeUrl(6)" class="btn btn-outline-secondary btn-sm @(Model.PageSize == 6 ? "active" : "")">
                            6 per page
                        </a>
                        <a href="@Model.GetPageSizeUrl(9)" class="btn btn-outline-secondary btn-sm @(Model.PageSize == 9 ? "active" : "")">
                            9 per page
                        </a>
                        <a href="@Model.GetPageSizeUrl(12)" class="btn btn-outline-secondary btn-sm @(Model.PageSize == 12 ? "active" : "")">
                            12 per page
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const paginationLinks = document.querySelectorAll('.pagination a.page-link');
            paginationLinks.forEach(link => {
                link.addEventListener('click', function() {
                    setTimeout(() => {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }, 100);
                });
            });

            const sortBySelect = document.getElementById('SortBy');
            const sortOrderSelect = document.getElementById('SortOrder');
            const filterForm = document.querySelector('form[method="get"]');

            const submitOnChange = function() {
                if (filterForm) {
                    filterForm.submit();
                }
            };

            if (sortBySelect) sortBySelect.addEventListener('change', submitOnChange);
            if (sortOrderSelect) sortOrderSelect.addEventListener('change', submitOnChange);

            var today = new Date().toISOString().split('T')[0];
            const endDateInput = document.getElementById('EndDate');
            if (endDateInput) {
                endDateInput.setAttribute('max', today);
            }

            const startDateInput = document.getElementById('StartDate');
            const validateDates = function(event) {
                const startDate = startDateInput?.value;
                const endDate = endDateInput?.value;

                if (startDate && endDate && startDate > endDate) {
                    alert('Start date must be before end date');
                    if (event?.target) {
                        event.target.value = '';
                    }
                }
            };

            if (startDateInput) startDateInput.addEventListener('change', validateDates);
            if (endDateInput) endDateInput.addEventListener('change', validateDates);
        });
    </script>
}