@page "{id}"
@model Presentation_RazorPage.Pages.News.DetailsModel
@{
    ViewData["Title"] = Model.Article?.NewsTitle ?? "Article Not Found";
}

@if (Model.Article != null)
{
    <div class="container py-5">
      

        <div class="row g-5">
            <!-- MAIN CONTENT COLUMN -->
            <div class="col-lg-8">
                <article class="blog-post">
                    <!-- Draft Status Alert -->
                    @if (HttpContext.Session.GetString("AuthToken") != null && Model.Article.NewsStatus != true)
                    {
                        <div class="alert alert-warning d-flex align-items-center mb-4 border-0 shadow-sm" role="alert">
                            <i class="fas fa-eye-slash fa-lg me-3"></i>
                            <div>
                                <h6 class="alert-heading fw-bold mb-1">Draft Mode</h6>
                                <p class="mb-0 small">This article is hidden from public view.</p>
                            </div>
                        </div>
                    }

                    <!-- Article Header -->
                    <header class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-primary text-uppercase tracking-wide">@Model.Article.CategoryName</span>
                            @if (!string.IsNullOrEmpty(Model.Article.NewsSource))
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="fas fa-newspaper me-1"></i>@Model.Article.NewsSource
                                </span>
                            }
                        </div>

                        <h1 class="display-5 fw-bold text-dark mb-3 lh-sm">@Model.Article.NewsTitle</h1>
                        <p class="fs-4 text-secondary fw-light mb-4">@Model.Article.Headline</p>

                        <!-- Author & Meta Data Bar -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between border-top border-bottom py-3 mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="fas fa-user text-secondary fa-lg"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@Model.Article.CreatedByName</div>
                                    <div class="text-muted small">
                                        <time datetime="@Model.Article.CreatedDate?.ToString("yyyy-MM-dd")">
                                            @Model.Article.CreatedDate?.ToString("MMM dd, yyyy")
                                        </time>
                                        @if (Model.Article.ModifiedDate.HasValue && Model.Article.ModifiedDate != Model.Article.CreatedDate)
                                        {
                                            <span class="ms-1 fst-italic text-muted">(Updated: @Model.Article.ModifiedDate?.ToString("MMM dd"))</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-2 mt-sm-0">
                                @if (HttpContext.Session.GetString("AuthToken") != null)
                                {
                                    var userRole = HttpContext.Session.GetString("UserRole");
                                    var userId = HttpContext.Session.GetInt32("UserId");

                                    if ((userRole == "1" && Model.Article.CreatedById == userId) || userRole == "Admin")
                                    {
                                        <a href="/Staff/Articles/Edit/@Model.Article.NewsArticleId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="fas fa-pen me-2"></i>Edit
                                        </a>
                                    }
                                }
                               
                            </div>
                        </div>
                    </header>

                    <!-- Article Body Content -->
                    <div class="article-content fs-5 lh-lg mb-5 text-break">
                        @if (Model.Article.NewsArticleImages != null && Model.Article.NewsArticleImages.Any())
                        {
                            <figure class="figure w-100 mb-4">
                                <img src="@Model.Article.NewsArticleImages.First().ImageUrl" class="figure-img img-fluid rounded w-100 shadow-sm" alt="@Model.Article.NewsTitle" onerror="this.style.display='none'">
                                @if (!string.IsNullOrEmpty(Model.Article.NewsArticleImages.First().Caption))
                                {
                                    <figcaption class="figure-caption text-center fst-italic">@Model.Article.NewsArticleImages.First().Caption</figcaption>
                                }
                            </figure>
                        }

                        @if (!string.IsNullOrEmpty(Model.Article.NewsContent))
                        {
                            @Html.Raw(Model.Article.NewsContent)
                        }
                        else
                        {
                            <p class="text-muted fst-italic p-5 text-center bg-light rounded">No content available for this article.</p>
                        }

                        <!-- Gallery Section -->
                        @if (Model.Article.NewsArticleImages != null && Model.Article.NewsArticleImages.Count > 1)
                        {
                            <div class="mt-5">
                                <h5 class="fw-bold mb-3 border-bottom pb-2">Image Gallery</h5>
                                <div class="row g-3">
                                    @foreach (var image in Model.Article.NewsArticleImages.Skip(1))
                                    {
                                        <div class="col-6 col-md-4">
                                            <div class="card border-0 shadow-sm h-100">
                                                <a href="@image.ImageUrl" target="_blank">
                                                    <img src="@image.ImageUrl" class="card-img-top rounded" style="height: 150px; object-fit: cover;" alt="@image.Caption" onerror="this.style.display='none'">
                                                </a>
                                                @if(!string.IsNullOrEmpty(image.Caption)) {
                                                    <div class="card-body p-2 text-center">
                                                        <small class="text-muted">@image.Caption</small>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Footer Tags -->
                    @if (Model.Article.Tags.Any())
                    {
                        <div class="mb-5">
                            <h6 class="text-uppercase text-muted small fw-bold mb-3">Tags</h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in Model.Article.Tags)
                                {
                                    <a href="/News/Index?search=@tag.TagName" class="btn btn-light btn-sm rounded-pill border hover-shadow">
                                        # @tag.TagName
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </article>
            </div>

            <!-- SIDEBAR COLUMN -->
            <div class="col-lg-4">
                <div class="position-sticky" style="top: 2rem;">
                    
                    <!-- Related News Widget -->
                    @if (Model.RelatedArticles.Any() || Model.SameCategoryArticles.Any())
                    {
                        var articlesToShow = Model.RelatedArticles.Any() ? Model.RelatedArticles : Model.SameCategoryArticles;
                        
                        <div class="p-4 mb-3 bg-light rounded shadow-sm">
                            <h4 class="fst-italic mb-3 pb-2 border-bottom">Recommended For You</h4>
                            <div class="d-flex flex-column gap-3">
                                @foreach (var article in articlesToShow.Take(5))
                                {
                                    <div class="card border-0 bg-transparent">
                                        <div class="card-body p-0">
                                            <small class="text-primary fw-bold text-uppercase" style="font-size: 0.7rem;">@article.CategoryName</small>
                                            <h6 class="mb-1 mt-1">
                                                <a href="/News/Details/@article.NewsArticleId" class="text-decoration-none text-dark hover-primary stretched-link">
                                                    @article.NewsTitle
                                                </a>
                                            </h6>
                                            <small class="text-muted">@article.CreatedDate?.ToString("MMM dd, yyyy")</small>
                                        </div>
                                    </div>
                                    @if(article != articlesToShow.Last()) { <hr class="my-1 text-muted opacity-25" /> }
                                }
                            </div>
                            <div class="mt-3 text-center">
                                <a href="/News/Index" class="btn btn-outline-dark btn-sm rounded-pill w-100">View All News</a>
                            </div>
                        </div>
                    }

                    <!-- About / Info Widget (Optional Placeholder) -->
                    <div class="p-4 bg-white border rounded shadow-sm">
                        <h4 class="fst-italic mb-3">About</h4>
                        <p class="mb-0 text-muted">Welcome to our news portal. We bring you the latest updates and featured stories from around the globe.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Article Not Found (Centered View) -->
    <div class="container d-flex align-items-center justify-content-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="mb-4 text-muted opacity-50">
                <i class="fas fa-newspaper fa-5x"></i>
            </div>
            <h1 class="display-4 fw-bold mb-3">Article Not Found</h1>
            <p class="lead text-muted mb-4">The article you are looking for does not exist or has been removed.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/News/Index" class="btn btn-primary px-4 rounded-pill">
                    <i class="fas fa-arrow-left me-2"></i>Back to News
                </a>
                <a href="/" class="btn btn-outline-secondary px-4 rounded-pill">
                    <i class="fas fa-home me-2"></i>Home
                </a>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function shareArticle() {
            if (navigator.share) {
                navigator.share({
                    title: document.title,
                    url: window.location.href
                });
            } else {
                navigator.clipboard.writeText(window.location.href).then(function() {
                    // Simple toast or alert fallback
                    const btn = document.querySelector('button[onclick="shareArticle()"]');
                    const originalHTML = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-check me-2"></i>Copied!';
                    btn.classList.replace('btn-outline-secondary', 'btn-success');
                    
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.classList.replace('btn-success', 'btn-outline-secondary');
                    }, 2000);
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Add hover effect class via JS or assume it's in CSS
            // Ctrl+S shortcut
            document.addEventListener('keydown', function(e) {
                if (e.ctrlKey && e.key === 's') {
                    e.preventDefault();
                    shareArticle();
                }
            });
        });
    </script>
    <style>
        /* Minimal scoped styles for better reading experience */
        .article-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin: 1.5rem 0;
        }
        .hover-primary:hover {
            color: var(--bs-primary) !important;
        }
        .hover-shadow:hover {
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
            transition: box-shadow .3s;
        }
    </style>
}