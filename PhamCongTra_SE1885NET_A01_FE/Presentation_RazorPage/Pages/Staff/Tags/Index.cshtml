@page
@model Presentation_RazorPage.Pages.Staff.Tags.IndexModel
@{
    ViewData["Title"] = "Tag Management";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small shadow-sm border-0 border-start border-success border-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small shadow-sm border-0 border-start border-danger border-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm">
        <div class="d-flex align-items-center">
            <h4 class="mb-0 fw-bold text-dark me-3">Tags</h4>
            <span class="badge bg-light text-dark border rounded-pill">@Model.Tags.Count items</span>
        </div>

        <div class="d-flex gap-2">
            <form method="get" class="d-flex">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" name="searchTerm"
                           value="@Model.SearchTerm" placeholder="Search tags...">
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="/Staff/Tags" class="btn btn-sm btn-outline-secondary" title="Clear Search">
                    <i class="fas fa-times"></i>
                </a>
            }

            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createTagModal">
                <i class="fas fa-plus me-1"></i> New Tag
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Tags.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr class="small text-uppercase">
                                <th class="ps-4" style="width: 30%;">Tag Name</th>
                                <th style="width: 40%;">Description</th>
                                <th class="text-center" style="width: 15%;">Usage</th>
                                <th class="text-end pe-4" style="width: 15%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tag in Model.Tags.OrderBy(t => t.TagName))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">
                                            <i class="fas fa-hashtag text-muted me-1 small"></i>@tag.TagName
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(tag.Note))
                                        {
                                            <span class="text-muted small">@tag.Note</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic opacity-50">No description</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (tag.ArticleCount > 0)
                                        {
                                            <span class="badge bg-white text-primary border rounded-pill px-3">
                                                @tag.ArticleCount articles
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill px-3">Unused</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <button type="button" class="btn btn-white border text-primary"
                                                    onclick="editTag(@tag.TagId, '@Html.Raw(Html.Encode(tag.TagName))', '@Html.Raw(Html.Encode(tag.Note ?? ""))')"
                                                    data-bs-toggle="modal" data-bs-target="#editTagModal" title="Edit">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>

                                            @if (tag.ArticleCount == 0)
                                            {
                                                <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-tagId="@tag.TagId">
                                                    <button type="submit" class="btn btn-white border text-danger" title="Delete"
                                                            onclick="return confirm('Delete tag: @tag.TagName?')"
                                                            style="border-left: 0 !important;">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-light border text-muted"
                                                        title="Cannot delete (In use)" disabled style="border-left: 0 !important;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-2 opacity-50"><i class="fas fa-tags fa-3x"></i></div>
                    <p class="text-muted mb-0">No tags found.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="createTagModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">New Tag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create" onsubmit="return confirm('Create this new tag?')">
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-1" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="CreateTag.TagName" class="form-label small text-muted text-uppercase fw-bold">Tag Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">#</span>
                            <input asp-for="CreateTag.TagName" class="form-control border-start-0" placeholder="e.g. Technology" />
                        </div>
                        <span asp-validation-for="CreateTag.TagName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateTag.Note" class="form-label small text-muted text-uppercase fw-bold">Description</label>
                        <textarea asp-for="CreateTag.Note" class="form-control" rows="3" placeholder="Optional description..."></textarea>
                        <span asp-validation-for="CreateTag.Note" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary px-4">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editTagModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Edit Tag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editTagForm" method="post" asp-page-handler="Update" onsubmit="return confirm('Save changes to this tag?')">
                <div class="modal-body">
                    <input type="hidden" id="editTagId" name="tagId" />
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Tag Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">#</span>
                            <input id="editTagName" name="tagName" class="form-control border-start-0" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Description</label>
                        <textarea id="editTagNote" name="note" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .btn-white {
            background-color: #fff;
            border-color: #dee2e6;
            color: #495057;
        }

            .btn-white:hover {
                background-color: #f8f9fa;
                border-color: #dee2e6;
                color: #212529;
            }
    </style>

    <partial name="_ValidationScriptsPartial" />
    <script>
        function editTag(id, name, note) {
            document.getElementById('editTagId').value = id;
            document.getElementById('editTagName').value = name;
            document.getElementById('editTagNote').value = note;
        }
    </script>
}