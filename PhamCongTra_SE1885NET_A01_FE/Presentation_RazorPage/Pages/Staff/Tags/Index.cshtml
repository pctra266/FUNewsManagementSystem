@page
@model Presentation_RazorPage.Pages.Staff.Tags.IndexModel
@{
    ViewData["Title"] = "Tag Management";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row">
        <div class="col-12">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">Tag Management</h1>
                </div>
                <div>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTagModal">
                        <i class="fas fa-plus me-2"></i>Create New Tag
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <!-- Search -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-10">
                            <label for="searchTerm" class="form-label">Search Tags</label>
                            <input type="text" class="form-control" id="searchTerm" name="searchTerm"
                                   value="@Model.SearchTerm" placeholder="Search by tag name or note...">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Tags Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">Tags (@Model.Tags.Count)</h6>
                </div>
                <div class="card-body">
                    @if (Model.Tags.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Tag Name</th>
                                        <th>Note</th>
                                        <th>Articles Using</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tag in Model.Tags)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@tag.TagId</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@tag.TagName</span>
                                            </td>
                                            <td>
                                                <span class="text-muted">@(tag.Note ?? "No description")</span>
                                            </td>
                                            <td>
                                                @if (tag.ArticleCount > 0)
                                                {
                                                    <span class="badge bg-success">@tag.ArticleCount articles</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Not used</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            onclick="editTag(@tag.TagId, '@Html.Raw(Html.Encode(tag.TagName))', '@Html.Raw(Html.Encode(tag.Note ?? ""))')"
                                                            data-bs-toggle="modal" data-bs-target="#editTagModal" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    @if (tag.ArticleCount == 0)
                                                    {
                                                        <form method="post" class="d-inline" asp-page-handler="Delete"
                                                              asp-route-tagId="@tag.TagId">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                    title="Delete"
                                                                    onclick="return confirm('Are you sure you want to delete this tag?')">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                title="Cannot delete - used by articles" disabled>
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Tags Found</h5>
                            <p class="text-muted">
                                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                                {
                                    <span>No tags match your search criteria.</span>
                                }
                                else
                                {
                                    <span>No tags have been created yet.</span>
                                }
                            </p>
                            <div class="mt-3">
                                @if (string.IsNullOrEmpty(Model.SearchTerm))
                                {
                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTagModal">
                                        <i class="fas fa-plus me-2"></i>Create First Tag
                                    </button>
                                }
                                else
                                {
                                    <a href="/Staff/Tags" class="btn btn-primary">
                                        <i class="fas fa-refresh me-2"></i>Clear Search
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Tag Modal -->
<div class="modal fade" id="createTagModal" tabindex="-1" aria-labelledby="createTagModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="createTagModalLabel">Create New Tag</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CreateTag.TagName" class="form-label">Tag Name *</label>
                        <input asp-for="CreateTag.TagName" class="form-control" placeholder="Enter tag name..." />
                        <span asp-validation-for="CreateTag.TagName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreateTag.Note" class="form-label">Description</label>
                        <textarea asp-for="CreateTag.Note" class="form-control" rows="3" placeholder="Optional description..."></textarea>
                        <span asp-validation-for="CreateTag.Note" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Tag</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Tag Modal -->
<div class="modal fade" id="editTagModal" tabindex="-1" aria-labelledby="editTagModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editTagForm" method="post" asp-page-handler="Update">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="editTagModalLabel">Edit Tag</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editTagId" name="tagId" />

                    <div class="mb-3">
                        <label class="form-label">Tag Name *</label>
                        <input id="editTagName" name="tagName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea id="editTagNote" name="note" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function editTag(id, name, note) {
            document.getElementById('editTagId').value = id;
            document.getElementById('editTagName').value = name;
            document.getElementById('editTagNote').value = note;
        }
    </script>
}
