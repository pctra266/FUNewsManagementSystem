@page
@model Presentation_RazorPage.Pages.Staff.CategoriesModel
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm">
        <h4 class="mb-0 text-dark fw-bold">Categories</h4>

        <div class="d-flex gap-2">
            <form method="get" class="d-flex">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <input type="text" class="form-control border-end-0" name="searchTerm"
                           value="@Model.SearchTerm" placeholder="Search categories...">
                    <button class="btn btn-outline-secondary border-start-0" type="submit">
                        <i class="fas fa-search text-muted"></i>
                    </button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="/Staff/Categories" class="btn btn-sm btn-outline-secondary" title="Clear Search">
                    <i class="fas fa-times"></i>
                </a>
            }

            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                <i class="fas fa-plus me-1"></i> New
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Categories.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4" style="width: 25%;">Name</th>
                                <th style="width: 30%;">Description</th>
                                <th class="text-center" style="width: 10%;">Articles</th>
                                <th class="text-center" style="width: 15%;">Status</th>
                                <th class="text-end pe-4" style="width: 20%; min-width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Categories.OrderBy(c => c.CategoryName))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@category.CategoryName</div>
                                        @if (category.ParentCategoryId.HasValue)
                                        {
                                            <small class="text-muted fst-italic">
                                                <i class="fas fa-level-up-alt fa-rotate-90 me-1"></i>Sub
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <div class="text-muted text-truncate" style="max-width: 280px;" title="@category.CategoryDescription">
                                            @category.CategoryDescription
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@category.ArticleCount</span>
                                    </td>
                                    <td class="text-center">
                                        @if (category.IsActive == true)
                                        {
                                            <span class="badge bg-success-subtle text-success rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">

                                            <button type="button" class="btn btn-white border text-primary" title="Edit"
                                                    onclick="editCategory(@category.CategoryId, '@category.CategoryName', '@category.CategoryDescription', @(category.ParentCategoryId ?? 0), @category.IsActive.ToString().ToLower())"
                                                    data-bs-toggle="modal" data-bs-target="#editCategoryModal">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>

                                            <form method="post" class="d-inline" asp-page-handler="ToggleStatus"
                                                  asp-route-id="@category.CategoryId" asp-route-currentStatus="@(category.IsActive ?? false)">
                                                @if (category.IsActive == true)
                                                {
                                                    <button type="submit" class="btn btn-white border text-warning" title="Deactivate" style="border-left: 0 !important;">
                                                        <i class="fas fa-eye-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-white border text-success" title="Activate" style="border-left: 0 !important;">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                }
                                            </form>

                                            @if (category.ArticleCount == 0)
                                            {
                                                <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-id="@category.CategoryId">
                                                    <button type="submit" class="btn btn-white border text-danger" title="Delete"
                                                            onclick="return confirm('Are you sure you want to delete this category?')"
                                                            style="border-left: 0 !important;">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-light border text-muted" title="Cannot delete (has articles)" disabled style="border-left: 0 !important;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-2"><i class="fas fa-inbox fa-2x"></i></div>
                    <p class="text-muted mb-0 small">No categories found.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create" onsubmit="return confirm('Create this new category?')">
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-1" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CreateCategory.CategoryName" class="form-label small text-muted text-uppercase fw-bold">Name</label>
                        <input asp-for="CreateCategory.CategoryName" class="form-control" placeholder="e.g. Technology" />
                        <span asp-validation-for="CreateCategory.CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreateCategory.CategoryDescription" class="form-label small text-muted text-uppercase fw-bold">Description</label>
                        <textarea asp-for="CreateCategory.CategoryDescription" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="CreateCategory.CategoryDescription" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="CreateCategory.ParentCategoryId" class="form-label small text-muted text-uppercase fw-bold">Parent</label>
                            <select asp-for="CreateCategory.ParentCategoryId" class="form-select">
                                <option value="">None (Top Level)</option>
                                @foreach (var category in Model.Categories.Where(c => c.IsActive == true))
                                {
                                    <option value="@category.CategoryId">@category.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input asp-for="CreateCategory.IsActive" type="checkbox" class="form-check-input" checked />
                                <label asp-for="CreateCategory.IsActive" class="form-check-label user-select-none">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary px-4">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editCategoryForm" method="post" asp-page-handler="Update" onsubmit="return confirm('Save changes to this category?')">
                <div class="modal-body">
                    <input type="hidden" id="editCategoryId" name="CategoryId" />

                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Name</label>
                        <input id="editCategoryName" name="CategoryName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">Description</label>
                        <textarea id="editCategoryDescription" name="CategoryDescription" class="form-control" rows="2" required></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small text-muted text-uppercase fw-bold">Parent</label>
                            <select id="editParentCategoryId" name="ParentCategoryId" class="form-select">
                                <option value="">None (Top Level)</option>
                                @foreach (var category in Model.Categories.Where(c => c.IsActive == true))
                                {
                                    <option value="@category.CategoryId">@category.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input id="editIsActive" name="IsActive" type="checkbox" class="form-check-input" />
                                <label class="form-check-label user-select-none">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary px-4">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function editCategory(id, name, description, parentId, isActive) {
            document.getElementById('editCategoryId').value = id;
            document.getElementById('editCategoryName').value = name;
            document.getElementById('editCategoryDescription').value = description;
            document.getElementById('editParentCategoryId').value = parentId || '';
            document.getElementById('editIsActive').checked = isActive;
        }
    </script>
}