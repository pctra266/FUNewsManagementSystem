@page
@model Presentation_RazorPage.Pages.Staff.NewsArticles.EditModel
@{
    ViewData["Title"] = "Edit News Article";
    var backLink = Model.GetSafeReturnUrl();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-dark">Edit Article</h4>
            <small class="text-muted">Update the fields below and save your changes.</small>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="@backLink">
            <i class="fas fa-arrow-left me-1"></i> Back to list
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="EditArticle.NewsArticleId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="mb-3">
                            <label asp-for="EditArticle.NewsTitle" class="form-label fw-semibold">Article Title *</label>
                            <input asp-for="EditArticle.NewsTitle" class="form-control" />
                            <span asp-validation-for="EditArticle.NewsTitle" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EditArticle.Headline" class="form-label fw-semibold">Headline *</label>
                            <input asp-for="EditArticle.Headline" class="form-control" />
                            <span asp-validation-for="EditArticle.Headline" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EditArticle.NewsContent" class="form-label fw-semibold">Content</label>
                            <textarea asp-for="EditArticle.NewsContent" class="form-control" rows="10"></textarea>
                            <span asp-validation-for="EditArticle.NewsContent" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EditArticle.NewsSource" class="form-label fw-semibold">News Source</label>
                            <input asp-for="EditArticle.NewsSource" class="form-control" placeholder="Original outlet, e.g. Reuters" />
                            <span asp-validation-for="EditArticle.NewsSource" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Current Images</label>
                            @if (Model.EditArticle.NewsArticleImages != null && Model.EditArticle.NewsArticleImages.Any())
                            {
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @foreach (var image in Model.EditArticle.NewsArticleImages)
                                    {
                                        <div class="position-relative" style="width: 100px; height: 100px;">
                                            <img src="@image.ImageUrl" class="img-thumbnail w-100 h-100" style="object-fit: cover;" onerror="this.src='/image/default-news.png'" />
                                            <button type="submit" asp-page-handler="DeleteImage" asp-route-imageId="@image.ImageId" asp-route-articleId="@Model.EditArticle.NewsArticleId" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 p-0 d-flex align-items-center justify-content-center" style="width: 20px; height: 20px; border-radius: 50%;" onclick="return confirm('Delete this image?');">
                                                <i class="fas fa-times" style="font-size: 10px;"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small fst-italic">No images uploaded.</p>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Upload New Images</label>
                            <input type="file" id="editImageFiles" name="imageFiles" class="form-control" accept="image/*" multiple />
                            <div class="form-text small">Max 5MB per file. You can select multiple images.</div>
                            <div id="editImagePreview" class="d-flex flex-wrap gap-2 mt-3 d-none" aria-live="polite"></div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="mb-3">
                            <label asp-for="EditArticle.CategoryId" class="form-label fw-semibold">Category *</label>
                            <select asp-for="EditArticle.CategoryId" class="form-select">
                                <option value="">Select Category</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId">@category.CategoryName</option>
                                }
                            </select>
                            <span asp-validation-for="EditArticle.CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tags</label>
                            <button type="button" class="btn btn-sm btn-outline-primary float-end" onclick="suggestTags()" id="suggestTagsButton">
                                <i class="fas fa-magic me-1"></i> Suggest Tags (AI)
                            </button>

                            <div id="suggestedTagsArea" class="mb-2" style="display: none;">
                                <small class="text-muted d-block mb-1">
                                    <i class="fas fa-lightbulb text-warning me-1"></i>AI Suggested Tags (click to toggle):
                                </small>
                                <div id="suggestedTagsChips" class="d-flex flex-wrap gap-1"></div>
                            </div>

                            <div class="border rounded p-2 overflow-auto" style="max-height: 280px;">
                                @foreach (var tag in Model.Tags)
                                {
                                    var isChecked = Model.EditArticle.SelectedTagIds.Contains(tag.TagId);
                                    <div class="form-check">
                                        <input class="form-check-input edit-tag-checkbox" type="checkbox"
                                               name="EditArticle.SelectedTagIds" value="@tag.TagId"
                                               id="editTag_@tag.TagId" @(isChecked ? "checked" : string.Empty)>
                                        <label class="form-check-label" for="editTag_@tag.TagId">
                                            @tag.TagName
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Publication Status</label>
                            <div class="form-check form-switch">
                                <input asp-for="EditArticle.NewsStatus" class="form-check-input" type="checkbox" id="publishedSwitch">
                                <label class="form-check-label" for="publishedSwitch">Published</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                            <a class="btn btn-outline-secondary" href="@backLink">Cancel</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function initImagePreview(inputId, previewId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);

            if (!input || !preview) {
                return;
            }

            input.addEventListener('change', () => renderImagePreview(input.files, preview));
        }

        function renderImagePreview(files, previewContainer) {
            previewContainer.innerHTML = '';

            if (!files?.length) {
                previewContainer.classList.add('d-none');
                return;
            }

            previewContainer.classList.remove('d-none');

            Array.from(files)
                .filter(file => file.type.startsWith('image/'))
                .forEach(file => {
                    const objectUrl = URL.createObjectURL(file);

                    const wrapper = document.createElement('div');
                    wrapper.className = 'border rounded position-relative overflow-hidden';
                    wrapper.style.width = '110px';
                    wrapper.style.height = '110px';

                    const img = document.createElement('img');
                    img.src = objectUrl;
                    img.alt = file.name;
                    img.className = 'w-100 h-100';
                    img.style.objectFit = 'cover';
                    img.onload = () => URL.revokeObjectURL(objectUrl);

                    const caption = document.createElement('div');
                    caption.className = 'position-absolute bottom-0 start-0 end-0 bg-dark bg-opacity-50 text-white text-truncate px-1';
                    caption.innerText = `${file.name} (${formatFileSize(file.size)})`;

                    wrapper.appendChild(img);
                    wrapper.appendChild(caption);
                    previewContainer.appendChild(wrapper);
                });

            if (!previewContainer.children.length) {
                previewContainer.classList.add('d-none');
            }
        }

        function formatFileSize(bytes) {
            if (bytes >= 1048576) {
                return `${(bytes / 1048576).toFixed(1)} MB`;
            }

            return `${Math.max(1, Math.round(bytes / 1024))} KB`;
        }

        document.addEventListener('DOMContentLoaded', () => {
            initImagePreview('editImageFiles', 'editImagePreview');
        });

        async function suggestTags() {
            const title = document.getElementById('EditArticle_NewsTitle').value;
            const headline = document.getElementById('EditArticle_Headline').value;
            const content = document.getElementById('EditArticle_NewsContent').value;
            const fullText = `${title} ${headline} ${content}`.trim();

            if (!fullText) {
                alert('Please provide title/headline/content before asking for suggestions.');
                return;
            }

            const btn = document.getElementById('suggestTagsButton');
            const originalInner = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Generating...';
            btn.disabled = true;

            try {
                const response = await fetch(`?handler=SuggestTags`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ content: fullText })
                });

                if (!response.ok) {
                    throw new Error('Failed to get suggestions');
                }

                const suggestions = await response.json();
                const entries = Object.entries(suggestions).sort((a, b) => b[1] - a[1]).slice(0, 8);

                const area = document.getElementById('suggestedTagsArea');
                const chips = document.getElementById('suggestedTagsChips');
                chips.innerHTML = '';

                if (!entries.length) {
                    area.style.display = 'none';
                    alert('No tags detected. Please add more content.');
                    return;
                }

                area.style.display = 'block';

                const checkboxes = Array.from(document.querySelectorAll('.edit-tag-checkbox'));
                entries.forEach(([tagName, confidence]) => {
                    const checkbox = checkboxes.find(cb => cb.nextElementSibling?.innerText.trim().toLowerCase() === tagName.toLowerCase());
                    if (!checkbox) {
                        return;
                    }

                    const chip = document.createElement('span');
                    chip.className = checkbox.checked ? 'badge bg-primary text-white' : 'badge bg-light text-dark border';
                    chip.style.cursor = 'pointer';
                    chip.style.padding = '0.35rem 0.55rem';
                    chip.innerHTML = `${tagName} <small class="opacity-75">(${Math.round(confidence * 100)}%)</small>`;

                    chip.addEventListener('click', () => {
                        checkbox.checked = !checkbox.checked;
                        chip.className = checkbox.checked ? 'badge bg-primary text-white' : 'badge bg-light text-dark border';
                    });

                    if (confidence >= 0.7 && !checkbox.checked)
                    {
                        checkbox.checked = true;
                        chip.className = 'badge bg-primary text-white';
                    }

                    chips.appendChild(chip);
                });
            } catch (err) {
                console.error(err);
                alert('Could not fetch tag suggestions. Please try again.');
            } finally {
                btn.innerHTML = originalInner;
                btn.disabled = false;
            }
        }
    </script>
}