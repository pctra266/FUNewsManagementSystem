@page
@model Presentation_RazorPage.Pages.Staff.NewsArticles.IndexModel
@{
    ViewData["Title"] = "News Articles Management";
    var currentListingUrl = $"{HttpContext.Request.Path}{HttpContext.Request.QueryString}";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small shadow-sm border-0 border-start border-success border-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm">
        <div class="d-flex align-items-center">
            <h4 class="mb-0 fw-bold text-dark me-3">News Articles</h4>
            <span class="badge bg-light text-dark border rounded-pill">@Model.Pagination.TotalItems total</span>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <form method="get" class="d-flex">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" name="searchTerm"
                           value="@Model.SearchTerm" placeholder="Search title, content...">
                </div>
            </form>

            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                <i class="fas fa-filter me-1"></i> Filters
            </button>

            <a class="btn btn-sm btn-primary" asp-page="Create" asp-route-returnUrl="@currentListingUrl" data-crud-action="create">
                <i class="fas fa-plus me-1"></i> New Article
            </a>
        </div>
    </div>

    <div class="collapse mb-3" id="advancedFilters">
        <div class="card card-body bg-light border-0 shadow-sm">
            <form method="get" class="row g-2">
                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Category</label>
                    <select class="form-select form-select-sm" name="categoryFilter">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryId" selected="@(Model.CategoryFilter == category.CategoryId)">@category.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Status</label>
                    <select class="form-select form-select-sm" name="statusFilter">
                        <option value="">All Status</option>
                        <option value="true" selected="@(Model.StatusFilter == true)">Active</option>
                        <option value="false" selected="@(Model.StatusFilter == false)">Draft</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Author</label>
                    <input type="text" class="form-control form-control-sm" name="authorFilter" value="@Model.AuthorFilter" placeholder="Author name...">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">From Date</label>
                    <input type="date" class="form-control form-control-sm" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">To Date</label>
                    <input type="date" class="form-control form-control-sm" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-sm btn-dark w-100 me-1">Apply</button>
                    <a href="/Staff/NewsArticles" class="btn btn-sm btn-outline-secondary" title="Clear"><i class="fas fa-times"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.NewsArticles.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr class="small text-uppercase">
                                <th class="ps-4" style="width: 35%;">Article Info</th>
                                <th style="width: 15%;">Category & Tags</th>
                                <th style="width: 20%;">Author & Date</th>
                                <th class="text-center" style="width: 10%;">Status</th>
                                <th class="text-end pe-4" style="width: 20%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var article in Model.NewsArticles.OrderByDescending(a => a.CreatedDate))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark mb-1">
                                            @if (!string.IsNullOrEmpty(article.Headline))
                                            {
                                                <i class="fas fa-quote-left text-muted me-1 small" style="font-size: 0.7rem;"></i>
                                            }
                                            @article.NewsTitle
                                        </div>
                                        @if (!string.IsNullOrEmpty(article.Headline))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width: 350px;">
                                                @article.Headline
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="mb-1">
                                            <span class="badge bg-light text-dark border">@article.CategoryName</span>
                                        </div>
                                        <div>
                                            @if (article.Tags != null && article.Tags.Any())
                                            {
                                                @foreach (var tag in article.Tags.Take(2))
                                                {
                                                    <span class="badge bg-white text-secondary border me-1" style="font-weight: normal;">#@tag.TagName</span>
                                                }
                                                @if (article.Tags.Count > 2)
                                                {
                                                    <span class="text-muted small" style="font-size: 0.75rem;">+@(article.Tags.Count - 2)</span>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-placeholder bg-light rounded-circle d-flex align-items-center justify-content-center text-secondary me-2" style="width: 32px; height: 32px;">
                                                <i class="fas fa-user small"></i>
                                            </div>
                                            <div>
                                                <div class="small fw-bold text-dark">@article.CreatedByName</div>
                                                <div class="small text-muted" style="font-size: 0.75rem;">
                                                    @article.CreatedDate?.ToString("MMM dd, yyyy")
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (article.NewsStatus == true)
                                        {
                                            <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-3">Draft</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a class="btn btn-white border text-primary" title="Edit article"
                                               asp-page="Edit"
                                               asp-route-id="@article.NewsArticleId"
                                               asp-route-returnUrl="@currentListingUrl"
                                               data-crud-action="edit">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>

                                            <button type="button" class="btn btn-white border text-secondary" title="Duplicate Draft" onclick="duplicateArticle('@article.NewsArticleId')" data-crud-action="modify">
                                                <i class="fas fa-copy"></i>
                                            </button>

                                            <form method="post" class="d-inline" asp-page-handler="ToggleStatus"
                                                  asp-route-articleId="@article.NewsArticleId" asp-route-currentStatus="@(article.NewsStatus ?? false)">
                                                @if (article.NewsStatus == true)
                                                {
                                                    <button type="submit" class="btn btn-white border text-warning" title="Unpublish" onclick="return confirm('Unpublish this article?')" style="border-left: 0 !important;" data-crud-action="modify">
                                                        <i class="fas fa-eye-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-white border text-success" title="Publish" onclick="return confirm('Publish this article?')" style="border-left: 0 !important;" data-crud-action="modify">
                                                        <i class="fas fa-upload"></i>
                                                    </button>
                                                }
                                            </form>

                                            <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-articleId="@article.NewsArticleId">
                                                <button type="submit" class="btn btn-white border text-danger" title="Delete"
                                                        onclick="return confirm('Are you sure? This removes all tags too.')"
                                                        style="border-left: 0 !important;"
                                                        data-crud-action="delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Pagination.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light border-top">
                        <small class="text-muted">Page @Model.Pagination.CurrentPage of @Model.Pagination.TotalPages</small>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link border-0 bg-transparent" href="@Model.GetPageUrl(Model.Pagination.CurrentPage - 1)">Previous</a>
                                </li>
                                @foreach (var pageNum in Model.Pagination.GetPageNumbers())
                                {
                                    <li class="page-item @(pageNum == Model.Pagination.CurrentPage ? "active" : "")">
                                        <a class="page-link border rounded-circle mx-1 text-center" style="width: 30px; height: 30px; line-height: 15px;"
                                           href="@Model.GetPageUrl(pageNum)">@pageNum</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                                    <a class="page-link border-0 bg-transparent" href="@Model.GetPageUrl(Model.Pagination.CurrentPage + 1)">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-2 opacity-50"><i class="fas fa-newspaper fa-3x"></i></div>
                    <p class="text-muted mb-3">No articles found matching your criteria.</p>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CategoryFilter.HasValue)
                    {
                        <a href="/Staff/NewsArticles" class="btn btn-sm btn-outline-primary">Clear Filters</a>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-primary" asp-page="Create" asp-route-returnUrl="@currentListingUrl" data-crud-action="create">
                            <i class="fas fa-plus me-1"></i> Create First Article
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .btn-white {
            background-color: #fff;
            border-color: #dee2e6;
            color: #495057;
        }

            .btn-white:hover {
                background-color: #f8f9fa;
                border-color: #dee2e6;
                color: #212529;
            }
    </style>

    <script>
        function duplicateArticle(articleId) {
            if (confirm('Create a draft copy of this article?')) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '/Staff/NewsArticles?handler=Duplicate';

                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'articleId';
                idInput.value = articleId;
                form.appendChild(idInput);

                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}