@page
@model Presentation_RazorPage.Pages.Staff.NewsArticles.IndexModel
@{
    ViewData["Title"] = "News Articles Management";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Staff/Articles">My Articles</a></li>
                    <li class="breadcrumb-item active" aria-current="page">All News Articles</li>
                </ol>
            </nav>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">News Articles Management</h1>
                    <p class="text-muted">Manage all news articles in the system</p>
                    @if (Model.Pagination.TotalItems > 0)
                    {
                        <small class="text-info">
                            Showing @Model.Pagination.StartItem - @Model.Pagination.EndItem of @Model.Pagination.TotalItems articles
                        </small>
                    }
                </div>
                <div>
                    <a href="/Staff/Articles/Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create New Article
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <!-- Advanced Search and Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-filter me-2"></i>Advanced Search & Filters
                    </h6>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-6">
                            <label for="searchTerm" class="form-label">Search Articles</label>
                            <input type="text" class="form-control" id="searchTerm" name="searchTerm"
                                   value="@Model.SearchTerm" placeholder="Search by title, content, or headline...">
                        </div>
                        <div class="col-md-6">
                            <label for="authorFilter" class="form-label">Author</label>
                            <input type="text" class="form-control" id="authorFilter" name="authorFilter"
                                   value="@Model.AuthorFilter" placeholder="Search by author name...">
                        </div>
                        <div class="col-md-3">
                            <label for="categoryFilter" class="form-label">Category</label>
                            <select class="form-select" id="categoryFilter" name="categoryFilter">
                                <option value="">All Categories</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId"
                                            selected="@(Model.CategoryFilter == category.CategoryId)">
                                        @category.CategoryName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="statusFilter" class="form-label">Status</label>
                            <select class="form-select" id="statusFilter" name="statusFilter">
                                <option value="">All Status</option>
                                <option value="true" selected="@(Model.StatusFilter == true)">Active</option>
                                <option value="false" selected="@(Model.StatusFilter == false)">Draft</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="startDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="startDate" name="startDate"
                                   value="@(Model.StartDate?.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="col-md-3">
                            <label for="endDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="endDate" name="endDate"
                                   value="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="col-md-6">
                            <label for="sortBy" class="form-label">Sort By</label>
                            <select class="form-select" id="sortBy" name="sortBy">
                                <option value="CreatedDate" selected="@(Model.SortBy == "CreatedDate")">Created Date</option>
                                <option value="NewsTitle" selected="@(Model.SortBy == "NewsTitle")">Title</option>
                                <option value="CategoryName" selected="@(Model.SortBy == "CategoryName")">Category</option>
                                <option value="AuthorName" selected="@(Model.SortBy == "AuthorName")">Author</option>
                                <option value="NewsStatus" selected="@(Model.SortBy == "NewsStatus")">Status</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="sortOrder" class="form-label">Order</label>
                            <select class="form-select" id="sortOrder" name="sortOrder">
                                <option value="desc" selected="@(Model.SortOrder == "desc")">Descending</option>
                                <option value="asc" selected="@(Model.SortOrder == "asc")">Ascending</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Apply Filters
                            </button>
                        </div>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CategoryFilter.HasValue || Model.StatusFilter.HasValue || !string.IsNullOrEmpty(Model.AuthorFilter) || Model.StartDate.HasValue || Model.EndDate.HasValue)
                    {
                        <div class="mt-3">
                            <a href="/Staff/NewsArticles" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-times me-2"></i>Clear All Filters
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Articles Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">Articles (@Model.NewsArticles.Count)</h6>
                </div>
                <div class="card-body">
                    @if (Model.NewsArticles.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Author</th>
                                        <th>Category</th>
                                        <th>Tags</th>
                                        <th>Status</th>
                                        <th>Created Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var article in Model.NewsArticles.OrderBy(a => a.NewsArticleId))
                                    {
                                        <tr>
                                            <td>
                                                <div>
                                                    <strong>@article.NewsTitle</strong>
                                                    @if (!string.IsNullOrEmpty(article.Headline))
                                                    {
                                                        <br>
                                                        <small class="text-muted">@article.Headline</small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="text-muted">@article.CreatedByName</span>
                                                @if (article.UpdatedById.HasValue && article.ModifiedDate.HasValue)
                                                {
                                                    <br>
                                                    <small class="text-info" title="Last updated by User ID @article.UpdatedById">
                                                        Updated on @article.ModifiedDate?.ToString("MMM dd, yyyy")
                                                    </small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@article.CategoryName</span>
                                            </td>
                                            <td>
                                                @if (article.Tags != null && article.Tags.Any())
                                                {
                                                    @foreach (var tag in article.Tags.Take(3))
                                                    {
                                                        <span class="badge bg-info text-dark me-1 mb-1">
                                                            <i class="fas fa-tag me-1"></i>@tag.TagName
                                                        </span>
                                                    }
                                                    @if (article.Tags.Count > 3)
                                                    {
                                                        <span class="badge bg-light text-dark">+@(article.Tags.Count - 3)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <small class="text-muted">No tags</small>
                                                }
                                            </td>
                                            <td>
                                                @if (article.NewsStatus == true)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check-circle me-1"></i>Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="fas fa-edit me-1"></i>Draft
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <span class="text-muted">@article.CreatedDate?.ToString("MMM dd, yyyy")</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="/News/Details/@article.NewsArticleId"
                                                       class="btn btn-sm btn-outline-info" title="View">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/Staff/Articles/Edit/@article.NewsArticleId"
                                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-success"
                                                            title="Duplicate" onclick="duplicateArticle('@article.NewsArticleId')">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                    <form method="post" class="d-inline" asp-page-handler="ToggleStatus"
                                                          asp-route-articleId="@article.NewsArticleId"
                                                          asp-route-currentStatus="@(article.NewsStatus ?? false)">
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                                title="@(article.NewsStatus == true ? "Unpublish" : "Publish")"
                                                                onclick="return confirm('@(article.NewsStatus == true ? "Unpublish this article?" : "Publish this article?")')">
                                                            <i class="fas fa-@(article.NewsStatus == true ? "eye-slash" : "upload")"></i>
                                                        </button>
                                                    </form>
                                                    <form method="post" class="d-inline" asp-page-handler="Delete"
                                                          asp-route-articleId="@article.NewsArticleId">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                title="Delete"
                                                                onclick="return confirm('Are you sure you want to delete this article? This will also remove all related tags.')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.Pagination.TotalPages > 1)
                        {
                            <nav aria-label="Articles pagination" class="mt-4">
                                <ul class="pagination justify-content-center">
                                    <!-- Previous Button -->
                                    <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                                        @if (Model.Pagination.HasPreviousPage)
                                        {
                                            <a class="page-link" href="@Model.GetPageUrl(Model.Pagination.CurrentPage - 1)">
                                                <span aria-hidden="true">&laquo;</span> Previous
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="page-link">
                                                <span aria-hidden="true">&laquo;</span> Previous
                                            </span>
                                        }
                                    </li>

                                    <!-- Page Numbers -->
                                    @foreach (var pageNum in Model.Pagination.GetPageNumbers())
                                    {
                                        <li class="page-item @(pageNum == Model.Pagination.CurrentPage ? "active" : "")">
                                            @if (pageNum == Model.Pagination.CurrentPage)
                                            {
                                                <span class="page-link">@pageNum</span>
                                            }
                                            else
                                            {
                                                <a class="page-link" href="@Model.GetPageUrl(pageNum)">@pageNum</a>
                                            }
                                        </li>
                                    }

                                    <!-- Next Button -->
                                    <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                                        @if (Model.Pagination.HasNextPage)
                                        {
                                            <a class="page-link" href="@Model.GetPageUrl(Model.Pagination.CurrentPage + 1)">
                                                Next <span aria-hidden="true">&raquo;</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="page-link">
                                                Next <span aria-hidden="true">&raquo;</span>
                                            </span>
                                        }
                                    </li>
                                </ul>
                            </nav>

                            <!-- Pagination Info -->
                            <div class="text-center mt-3">
                                <small class="text-muted">
                                    Page @Model.Pagination.CurrentPage of @Model.Pagination.TotalPages
                                    (@Model.Pagination.TotalItems total articles)
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Articles Found</h5>
                            <p class="text-muted">
                                No articles match your search criteria. Try adjusting your filters.
                            </p>
                            <div class="mt-3">
                                <a href="/Staff/NewsArticles" class="btn btn-primary me-2">
                                    <i class="fas fa-refresh me-2"></i>Clear Filters
                                </a>
                                <a href="/Staff/Articles/Create" class="btn btn-success">
                                    <i class="fas fa-plus me-2"></i>Create New Article
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function duplicateArticle(articleId) {
            if (confirm('Do you want to create a duplicate of this article? The duplicate will be created as a draft.')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/Staff/NewsArticles?handler=Duplicate';

                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'articleId';
                input.value = articleId;
                form.appendChild(input);

                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }

                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                        <text>
                        var searchInput = document.createElement('input');
                        searchInput.type = 'hidden';
                        searchInput.name = 'searchTerm';
                        searchInput.value = '@Model.SearchTerm';
                        form.appendChild(searchInput);
                        </text>
                }

                @if (Model.CategoryFilter.HasValue)
                {
                        <text>
                        var catInput = document.createElement('input');
                        catInput.type = 'hidden';
                        catInput.name = 'categoryFilter';
                        catInput.value = '@Model.CategoryFilter';
                        form.appendChild(catInput);
                        </text>
                }

                @if (Model.StatusFilter.HasValue)
                {
                        <text>
                        var statusInput = document.createElement('input');
                        statusInput.type = 'hidden';
                        statusInput.name = 'statusFilter';
                        statusInput.value = '@Model.StatusFilter';
                        form.appendChild(statusInput);
                        </text>
                }

                document.body.appendChild(form);
                form.submit();
            }
        }

        $(document).ready(function() {
            $('#sortBy, #sortOrder').on('change', function() {
                $(this).closest('form').submit();
            });

            $('#startDate, #endDate').on('change', function() {
                var startDate = $('#startDate').val();
                var endDate = $('#endDate').val();

                if (startDate && endDate && startDate > endDate) {
                    alert('Start date must be before end date');
                    $(this).val('');
                }
            });
        });
    </script>
}