@page
@model Presentation_RazorPage.Pages.Staff.NewsArticles.IndexModel
@{
    ViewData["Title"] = "News Articles Management";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small shadow-sm border-0 border-start border-success border-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm">
        <div class="d-flex align-items-center">
            <h4 class="mb-0 fw-bold text-dark me-3">News Articles</h4>
            <span class="badge bg-light text-dark border rounded-pill">@Model.Pagination.TotalItems total</span>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <form method="get" class="d-flex">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" name="searchTerm"
                           value="@Model.SearchTerm" placeholder="Search title, content...">
                </div>
            </form>

            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                <i class="fas fa-filter me-1"></i> Filters
            </button>

            <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createArticleModal">
                <i class="fas fa-plus me-1"></i> New Article
            </button>
        </div>
    </div>

    <div class="collapse mb-3" id="advancedFilters">
        <div class="card card-body bg-light border-0 shadow-sm">
            <form method="get" class="row g-2">
                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Category</label>
                    <select class="form-select form-select-sm" name="categoryFilter">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryId" selected="@(Model.CategoryFilter == category.CategoryId)">@category.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Status</label>
                    <select class="form-select form-select-sm" name="statusFilter">
                        <option value="">All Status</option>
                        <option value="true" selected="@(Model.StatusFilter == true)">Active</option>
                        <option value="false" selected="@(Model.StatusFilter == false)">Draft</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Author</label>
                    <input type="text" class="form-control form-control-sm" name="authorFilter" value="@Model.AuthorFilter" placeholder="Author name...">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">From Date</label>
                    <input type="date" class="form-control form-control-sm" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">To Date</label>
                    <input type="date" class="form-control form-control-sm" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-sm btn-dark w-100 me-1">Apply</button>
                    <a href="/Staff/NewsArticles" class="btn btn-sm btn-outline-secondary" title="Clear"><i class="fas fa-times"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.NewsArticles.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr class="small text-uppercase">
                                <th class="ps-4" style="width: 35%;">Article Info</th>
                                <th style="width: 15%;">Category & Tags</th>
                                <th style="width: 20%;">Author & Date</th>
                                <th class="text-center" style="width: 10%;">Status</th>
                                <th class="text-end pe-4" style="width: 20%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var article in Model.NewsArticles.OrderByDescending(a => a.CreatedDate))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark mb-1">
                                            @if (!string.IsNullOrEmpty(article.Headline))
                                            {
                                                <i class="fas fa-quote-left text-muted me-1 small" style="font-size: 0.7rem;"></i>
                                            }
                                            @article.NewsTitle
                                        </div>
                                        @if (!string.IsNullOrEmpty(article.Headline))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width: 350px;">
                                                @article.Headline
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="mb-1">
                                            <span class="badge bg-light text-dark border">@article.CategoryName</span>
                                        </div>
                                        <div>
                                            @if (article.Tags != null && article.Tags.Any())
                                            {
                                                @foreach (var tag in article.Tags.Take(2))
                                                {
                                                    <span class="badge bg-white text-secondary border me-1" style="font-weight: normal;">#@tag.TagName</span>
                                                }
                                                @if (article.Tags.Count > 2)
                                                {
                                                    <span class="text-muted small" style="font-size: 0.75rem;">+@(article.Tags.Count - 2)</span>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-placeholder bg-light rounded-circle d-flex align-items-center justify-content-center text-secondary me-2" style="width: 32px; height: 32px;">
                                                <i class="fas fa-user small"></i>
                                            </div>
                                            <div>
                                                <div class="small fw-bold text-dark">@article.CreatedByName</div>
                                                <div class="small text-muted" style="font-size: 0.75rem;">
                                                    @article.CreatedDate?.ToString("MMM dd, yyyy")
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (article.NewsStatus == true)
                                        {
                                            <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-3">Draft</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <button type="button" class="btn btn-white border text-primary" title="Edit article"
                                                    data-bs-toggle="modal" data-bs-target="#editArticleModal"
                                                    data-article-id="@article.NewsArticleId"
                                                    data-title="@System.Net.WebUtility.HtmlEncode(article.NewsTitle ?? "")"
                                                    data-headline="@System.Net.WebUtility.HtmlEncode(article.Headline ?? "")"
                                                    data-content="@System.Net.WebUtility.HtmlEncode(article.NewsContent ?? "")"
                                                    data-source="@System.Net.WebUtility.HtmlEncode(article.NewsSource ?? "")"
                                                    data-category-id="@article.CategoryId"
                                                    data-status="@(article.NewsStatus == true ? "true" : "false")"
                                                    data-tag-ids="@string.Join(",", article.Tags?.Select(t => t.TagId) ?? new List<int>())">
                                                <i class="fas fa-pencil-alt"></i>
                                            </button>

                                            <button type="button" class="btn btn-white border text-secondary" title="Duplicate Draft" onclick="duplicateArticle('@article.NewsArticleId')">
                                                <i class="fas fa-copy"></i>
                                            </button>

                                            <form method="post" class="d-inline" asp-page-handler="ToggleStatus"
                                                  asp-route-articleId="@article.NewsArticleId" asp-route-currentStatus="@(article.NewsStatus ?? false)">
                                                @if (article.NewsStatus == true)
                                                {
                                                    <button type="submit" class="btn btn-white border text-warning" title="Unpublish" onclick="return confirm('Unpublish this article?')" style="border-left: 0 !important;">
                                                        <i class="fas fa-eye-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-white border text-success" title="Publish" onclick="return confirm('Publish this article?')" style="border-left: 0 !important;">
                                                        <i class="fas fa-upload"></i>
                                                    </button>
                                                }
                                            </form>

                                            <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-articleId="@article.NewsArticleId">
                                                <button type="submit" class="btn btn-white border text-danger" title="Delete"
                                                        onclick="return confirm('Are you sure? This removes all tags too.')"
                                                        style="border-left: 0 !important;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Pagination.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light border-top">
                        <small class="text-muted">Page @Model.Pagination.CurrentPage of @Model.Pagination.TotalPages</small>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link border-0 bg-transparent" href="@Model.GetPageUrl(Model.Pagination.CurrentPage - 1)">Previous</a>
                                </li>
                                @foreach (var pageNum in Model.Pagination.GetPageNumbers())
                                {
                                    <li class="page-item @(pageNum == Model.Pagination.CurrentPage ? "active" : "")">
                                        <a class="page-link border rounded-circle mx-1 text-center" style="width: 30px; height: 30px; line-height: 15px;"
                                           href="@Model.GetPageUrl(pageNum)">@pageNum</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                                    <a class="page-link border-0 bg-transparent" href="@Model.GetPageUrl(Model.Pagination.CurrentPage + 1)">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-2 opacity-50"><i class="fas fa-newspaper fa-3x"></i></div>
                    <p class="text-muted mb-3">No articles found matching your criteria.</p>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CategoryFilter.HasValue)
                    {
                        <a href="/Staff/NewsArticles" class="btn btn-sm btn-outline-primary">Clear Filters</a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createArticleModal">
                            <i class="fas fa-plus me-1"></i> Create First Article
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="createArticleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">Create Article</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="CategoryFilter" value="@Model.CategoryFilter" />
                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                    <input type="hidden" name="AuthorFilter" value="@Model.AuthorFilter" />
                    <input type="hidden" name="StartDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="EndDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="SortBy" value="@Model.SortBy" />
                    <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
                    <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label asp-for="CreateArticle.NewsTitle" class="form-label">Article Title *</label>
                                <input asp-for="CreateArticle.NewsTitle" class="form-control" />
                                <span asp-validation-for="CreateArticle.NewsTitle" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CreateArticle.Headline" class="form-label">Headline *</label>
                                <input asp-for="CreateArticle.Headline" class="form-control" />
                                <span asp-validation-for="CreateArticle.Headline" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CreateArticle.NewsContent" class="form-label">Content</label>
                                <textarea asp-for="CreateArticle.NewsContent" class="form-control" rows="8"></textarea>
                                <span asp-validation-for="CreateArticle.NewsContent" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CreateArticle.NewsSource" class="form-label">News Source</label>
                                <input asp-for="CreateArticle.NewsSource" class="form-control" />
                                <span asp-validation-for="CreateArticle.NewsSource" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="CreateArticle.CategoryId" class="form-label">Category *</label>
                                <select asp-for="CreateArticle.CategoryId" class="form-select">
                                    <option value="">Select Category</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryId">@category.CategoryName</option>
                                    }
                                </select>
                                <span asp-validation-for="CreateArticle.CategoryId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Tags</label>
                                <div class="border rounded p-2 overflow-auto" style="max-height: 220px;">
                                    @foreach (var tag in Model.Tags)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="CreateArticle.SelectedTagIds" value="@tag.TagId"
                                                   id="createTag_@tag.TagId">
                                            <label class="form-check-label" for="createTag_@tag.TagId">
                                                @tag.TagName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Publication Status</label>
                                <div class="form-check">
                                    <input asp-for="CreateArticle.NewsStatus" type="checkbox" class="form-check-input" id="createStatus">
                                    <label class="form-check-label" for="createStatus">Publish immediately</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editArticleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Article</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="CategoryFilter" value="@Model.CategoryFilter" />
                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                    <input type="hidden" name="AuthorFilter" value="@Model.AuthorFilter" />
                    <input type="hidden" name="StartDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="EndDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="SortBy" value="@Model.SortBy" />
                    <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
                    <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />

                    <input asp-for="EditArticle.NewsArticleId" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label asp-for="EditArticle.NewsTitle" class="form-label">Article Title *</label>
                                <input asp-for="EditArticle.NewsTitle" class="form-control" />
                                <span asp-validation-for="EditArticle.NewsTitle" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditArticle.Headline" class="form-label">Headline *</label>
                                <input asp-for="EditArticle.Headline" class="form-control" />
                                <span asp-validation-for="EditArticle.Headline" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditArticle.NewsContent" class="form-label">Content</label>
                                <textarea asp-for="EditArticle.NewsContent" class="form-control" rows="8"></textarea>
                                <span asp-validation-for="EditArticle.NewsContent" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditArticle.NewsSource" class="form-label">News Source</label>
                                <input asp-for="EditArticle.NewsSource" class="form-control" />
                                <span asp-validation-for="EditArticle.NewsSource" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="EditArticle.CategoryId" class="form-label">Category *</label>
                                <select asp-for="EditArticle.CategoryId" class="form-select">
                                    <option value="">Select Category</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryId">@category.CategoryName</option>
                                    }
                                </select>
                                <span asp-validation-for="EditArticle.CategoryId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Tags</label>
                                <div class="border rounded p-2 overflow-auto" style="max-height: 220px;">
                                    @foreach (var tag in Model.Tags)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input edit-tag-checkbox" type="checkbox"
                                                   name="EditArticle.SelectedTagIds" value="@tag.TagId"
                                                   id="editTag_@tag.TagId">
                                            <label class="form-check-label" for="editTag_@tag.TagId">
                                                @tag.TagName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Publication Status</label>
                                <div class="form-check">
                                    <input asp-for="EditArticle.NewsStatus" type="checkbox" class="form-check-input" id="editStatus">
                                    <label class="form-check-label" for="editStatus">Published</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .btn-white {
            background-color: #fff;
            border-color: #dee2e6;
            color: #495057;
        }

            .btn-white:hover {
                background-color: #f8f9fa;
                border-color: #dee2e6;
                color: #212529;
            }
    </style>

    <partial name="_ValidationScriptsPartial" />

    <script>
        const editArticleModal = document.getElementById('editArticleModal');

        editArticleModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            if (!button) {
                return;
            }

            document.getElementById('EditArticle_NewsArticleId').value = button.getAttribute('data-article-id') || '';
            document.getElementById('EditArticle_NewsTitle').value = button.getAttribute('data-title') || '';
            document.getElementById('EditArticle_Headline').value = button.getAttribute('data-headline') || '';
            document.getElementById('EditArticle_NewsContent').value = button.getAttribute('data-content') || '';
            document.getElementById('EditArticle_NewsSource').value = button.getAttribute('data-source') || '';
            document.getElementById('EditArticle_CategoryId').value = button.getAttribute('data-category-id') || '';
            document.getElementById('editStatus').checked = (button.getAttribute('data-status') === 'true');

            const tagIds = (button.getAttribute('data-tag-ids') || '')
                .split(',')
                .map(x => x.trim())
                .filter(x => x.length);

            document.querySelectorAll('.edit-tag-checkbox').forEach(cb => {
                cb.checked = tagIds.includes(cb.value);
            });
        });

        @if (Model.ShowCreateModal)
        {
            <text>new bootstrap.Modal(document.getElementById('createArticleModal')).show();</text>
        }

        @if (Model.ShowEditModal)
        {
            <text>new bootstrap.Modal(document.getElementById('editArticleModal')).show();</text>
        }

        // Keep the exact same logic for duplication
        function duplicateArticle(articleId) {
            if (confirm('Create a draft copy of this article?')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/Staff/NewsArticles?handler=Duplicate';

                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'articleId';
                input.value = articleId;
                form.appendChild(input);

                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}