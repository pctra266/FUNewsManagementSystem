@page
@model Presentation_RazorPage.Pages.Staff.Articles.IndexModel
@{
    ViewData["Title"] = "My Articles";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">My Articles</h1>
                </div>
                <div>
                    <a href="/Staff/Articles/Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create New Article
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <!-- Search and Filter -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">
                        <i class="fas fa-filter me-2"></i>Search & Filter Options
                    </h6>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label for="searchTerm" class="form-label">
                                <i class="fas fa-search me-1"></i>Search Articles
                            </label>
                            <input type="text" class="form-control" id="searchTerm" name="searchTerm"
                                   value="@Model.SearchTerm" placeholder="Search by title, content, or headline...">
                        </div>
                        <div class="col-md-3">
                            <label for="categoryFilter" class="form-label">
                                <i class="fas fa-folder me-1"></i>Category
                            </label>
                            <select class="form-select" id="categoryFilter" name="categoryFilter">
                                <option value="">All Categories</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId"
                                            selected="@(Model.CategoryFilter == category.CategoryId)">
                                        @category.CategoryName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="statusFilter" class="form-label">
                                <i class="fas fa-toggle-on me-1"></i>Status
                            </label>
                            <select class="form-select" id="statusFilter" name="statusFilter">
                                <option value="">All Status</option>
                                <option value="true" selected="@(Model.StatusFilter == true)">Published</option>
                                <option value="false" selected="@(Model.StatusFilter == false)">Draft</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="startDate" class="form-label">
                                <i class="fas fa-calendar-alt me-1"></i>From Date
                            </label>
                            <input type="date" class="form-control" id="startDate" name="startDate"
                                   value="@(Model.StartDate?.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="col-md-3">
                            <label for="endDate" class="form-label">
                                <i class="fas fa-calendar-check me-1"></i>To Date
                            </label>
                            <input type="date" class="form-control" id="endDate" name="endDate"
                                   value="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="col-md-2">
                            <label for="sortOrder" class="form-label">
                                <i class="fas fa-sort me-1"></i>Sort
                            </label>
                            <select class="form-select" id="sortOrder" name="sortOrder">
                                <option value="desc" selected="@(Model.SortOrder == "desc")">Newest First</option>
                                <option value="asc" selected="@(Model.SortOrder == "asc")">Oldest First</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Apply
                            </button>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <a href="/Staff/Articles" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-times me-2"></i>Clear
                            </a>
                        </div>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CategoryFilter.HasValue || Model.StatusFilter.HasValue || Model.StartDate.HasValue || Model.EndDate.HasValue)
                    {
                        <div class="mt-3">
                            <span class="badge bg-info me-2">
                                Active Filters:
                                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                                {
                                    <text>Search </text>
                                }
                                @if (Model.CategoryFilter.HasValue)
                                {
                                    <text>Category </text>
                                }
                                @if (Model.StatusFilter.HasValue)
                                {
                                    <text>Status </text>
                                }
                                @if (Model.StartDate.HasValue || Model.EndDate.HasValue)
                                {
                                    <text>Date Range </text>
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Articles Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-semibold text-primary">Articles (@Model.MyArticles.Count)</h6>
                </div>
                <div class="card-body">
                    @if (Model.MyArticles.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Category</th>
                                        <th>Tags</th>
                                        <th>Status</th>
                                        <th>Created Date</th>
                                        <th>Modified Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var article in Model.MyArticles.OrderByDescending(a => a.CreatedDate))
                                    {
                                        <tr>
                                            <td>
                                                <div>
                                                    <strong>@article.NewsTitle</strong>
                                                    <br>
                                                    <small class="text-muted">@article.Headline</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@article.CategoryName</span>
                                            </td>
                                            <td>
                                                @if (article.Tags != null && article.Tags.Any())
                                                {
                                                    @foreach (var tag in article.Tags.Take(3))
                                                    {
                                                        <span class="badge bg-info text-dark me-1">
                                                            <i class="fas fa-tag me-1"></i>@tag.TagName
                                                        </span>
                                                    }
                                                    @if (article.Tags.Count > 3)
                                                    {
                                                        <span class="badge bg-light text-dark">+@(article.Tags.Count - 3)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <small class="text-muted">No tags</small>
                                                }
                                            </td>
                                            <td>
                                                @if (article.NewsStatus == true)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check me-1"></i>Published
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="fas fa-edit me-1"></i>Draft
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <small>@article.CreatedDate?.ToString("MMM dd, yyyy")</small>
                                            </td>
                                            <td>
                                                <small>@(article.ModifiedDate?.ToString("MMM dd, yyyy") ?? "Never")</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="/Staff/Articles/Edit/@article.NewsArticleId"
                                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="/News/Details/@article.NewsArticleId"
                                                       class="btn btn-sm btn-outline-info" title="View" target="_blank">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-success"
                                                            title="Duplicate Article"
                                                            onclick="duplicateArticle('@article.NewsArticleId')">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                    <form method="post" class="d-inline" asp-page-handler="ToggleStatus"
                                                          asp-route-id="@article.NewsArticleId"
                                                          asp-route-currentStatus="@(article.NewsStatus ?? false)">
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                                title="@(article.NewsStatus == true ? "Unpublish" : "Publish")"
                                                                onclick="return confirm('@(article.NewsStatus == true ? "Unpublish this article?" : "Publish this article?")')">
                                                            <i class="fas fa-@(article.NewsStatus == true ? "eye-slash" : "upload")"></i>
                                                        </button>
                                                    </form>
                                                    <form method="post" class="d-inline" asp-page-handler="Delete"
                                                          asp-route-id="@article.NewsArticleId">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                title="Delete"
                                                                onclick="return confirm('Are you sure you want to delete this article? This will also remove all related tags.')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Articles Found</h5>
                            <p class="text-muted">
                                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CategoryFilter.HasValue || Model.StatusFilter.HasValue)
                                {
                                    <span>No articles match your search criteria. Try adjusting your filters.</span>
                                }
                                else
                                {
                                    <span>You haven't created any articles yet. Get started by creating your first article!</span>
                                }
                            </p>
                            <div class="mt-3">
                                @if (string.IsNullOrEmpty(Model.SearchTerm) && !Model.CategoryFilter.HasValue && !Model.StatusFilter.HasValue)
                                {
                                    <a href="/Staff/Articles/Create" class="btn btn-primary">
                                        <i class="fas fa-plus me-2"></i>Create Your First Article
                                    </a>
                                }
                                else
                                {
                                    <a href="/Staff/Articles" class="btn btn-primary">
                                        <i class="fas fa-refresh me-2"></i>Clear Filters
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function duplicateArticle(articleId) {
            if (confirm('Do you want to create a duplicate of this article? The duplicate will be created as a draft with all tags copied.')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '/Staff/Articles?handler=Duplicate';

                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'id';
                input.value = articleId;
                form.appendChild(input);

                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }

                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                        <text>
                        var searchInput = document.createElement('input');
                        searchInput.type = 'hidden';
                        searchInput.name = 'searchTerm';
                        searchInput.value = '@Model.SearchTerm';
                        form.appendChild(searchInput);
                        </text>
                }

                @if (Model.CategoryFilter.HasValue)
                {
                        <text>
                        var catInput = document.createElement('input');
                        catInput.type = 'hidden';
                        catInput.name = 'categoryFilter';
                        catInput.value = '@Model.CategoryFilter';
                        form.appendChild(catInput);
                        </text>
                }

                @if (Model.StatusFilter.HasValue)
                {
                        <text>
                        var statusInput = document.createElement('input');
                        statusInput.type = 'hidden';
                        statusInput.name = 'statusFilter';
                        statusInput.value = '@Model.StatusFilter';
                        form.appendChild(statusInput);
                        </text>
                }

                document.body.appendChild(form);
                form.submit();
            }
        }

        $(document).ready(function() {
            $('#startDate, #endDate').on('change', function() {
                var startDate = $('#startDate').val();
                var endDate = $('#endDate').val();

                if (startDate && endDate && startDate > endDate) {
                    alert('Start date must be before end date');
                    $(this).val('');
                }
            });
        });
    </script>
}