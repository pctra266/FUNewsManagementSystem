@page
@model Presentation_RazorPage.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Account Settings</h2>
            <p class="text-muted small mb-0">Manage your personal information and security preferences.</p>
        </div>
     
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Success</h6>
                    <small>@TempData["SuccessMessage"]</small>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-circle text-danger fs-4 me-3"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Error</h6>
                    <small>@TempData["ErrorMessage"]</small>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body text-center p-5">
                    <div class="mb-4 position-relative d-inline-block">
                        <div class="avatar-circle bg-primary bg-gradient text-white d-flex align-items-center justify-content-center mx-auto shadow"
                             style="width: 120px; height: 120px; border-radius: 50%; font-size: 3rem; font-weight: bold;">
                            @if (!string.IsNullOrEmpty(Model.CurrentUser?.AccountName))
                            {
                                @Model.CurrentUser.AccountName.Substring(0, 1).ToUpper()
                            }
                            else
                            {
                                <i class="fas fa-user"></i>
                            }
                        </div>
                        <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-light rounded-circle">
                            <span class="visually-hidden">Active</span>
                        </span>
                    </div>

                    <h4 class="fw-bold text-dark mb-1">@Model.CurrentUser?.AccountName</h4>
                    <div class="mb-4">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                            <i class="fas fa-user-tie me-1"></i>Staff Member
                        </span>
                    </div>

                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <div class="text-start p-3 bg-light rounded-3 w-100">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Account ID</small>
                            <span class="fw-bold text-dark font-monospace">#@Model.CurrentUser?.AccountId</span>
                        </div>
                    </div>

                    <div class="alert alert-light text-start border-0 small text-muted mb-0">
                        <i class="fas fa-shield-alt text-primary me-2"></i>
                        Your account is secured. Only you and Administrators can view this information.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="fas fa-user-edit"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Personal Details</h5>
                            <small class="text-muted">Update your public profile information</small>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="UpdateProfile" onsubmit="return confirm('Save changes to your profile?')">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase fw-bold text-muted">Full Name</label>
                                <input asp-for="UpdateProfile.AccountName" class="form-control form-control-lg bg-light border-0" placeholder="Enter your full name" />
                                <span asp-validation-for="UpdateProfile.AccountName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase fw-bold text-muted">Email Address</label>
                                <input value="@Model.CurrentUser?.AccountEmail" class="form-control form-control-lg bg-light border-0" readonly disabled />
                                <div class="form-text small"><i class="fas fa-lock me-1"></i>Email cannot be changed directly.</div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-dark px-4 rounded-pill">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="fas fa-key"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Security</h5>
                            <small class="text-muted">Change your password to keep your account secure</small>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="ChangePassword" onsubmit="return confirm('Update your password?')">
                        <div class="mb-3">
                            <label asp-for="ChangePassword.CurrentPassword" class="form-label small text-uppercase fw-bold text-muted">Current Password</label>
                            <input asp-for="ChangePassword.CurrentPassword" type="password" class="form-control form-control-lg bg-light border-0" placeholder="••••••••" />
                            <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ChangePassword.NewPassword" class="form-label small text-uppercase fw-bold text-muted">New Password</label>
                                <input asp-for="ChangePassword.NewPassword" type="password" class="form-control form-control-lg bg-light border-0" placeholder="Min 6 characters" />
                                <span asp-validation-for="ChangePassword.NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ChangePassword.ConfirmPassword" class="form-label small text-uppercase fw-bold text-muted">Confirm New Password</label>
                                <input asp-for="ChangePassword.ConfirmPassword" type="password" class="form-control form-control-lg bg-light border-0" placeholder="Re-enter password" />
                                <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-outline-danger px-4 rounded-pill">
                                Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        /* Thêm style input khi focus để tạo cảm giác cao cấp */
        .form-control:focus {
            background-color: #fff !important;
            box-shadow: 0 0 0 4px rgba(0,0,0,0.05);
            border-color: #dee2e6;
        }

        .btn-dark {
            background-color: #1a1a1a;
            border-color: #1a1a1a;
        }

            .btn-dark:hover {
                background-color: #000;
                border-color: #000;
            }
    </style>
}